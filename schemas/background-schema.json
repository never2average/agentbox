{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Background Workers Schema",
  "description": "Validation schema for background services: training, data processing, alert manager, scheduled tasks",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "bg_type": { "enum": ["training", "data_processing", "alert_manager", "scheduled_task"] },
    "status": { "enum": ["active", "paused", "stopped", "error"] },
    "worker_type": { "enum": ["runtime", "agent", "recipe"] },
    "worker": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/definitions/worker_type" },
        "runtime_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "recipe_id": { "type": "string" },
        "metrics_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "routing_filter": {
      "type": "object",
      "properties": {
        "type": { "enum": ["path"] },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "io_binding": {
      "type": "object",
      "required": ["connector_id", "routing"],
      "properties": {
        "connector_id": { "type": "string" },
        "governance_id": { "type": "string" },
        "routing": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "filters": { "type": "array", "items": { "$ref": "#/definitions/routing_filter" } },
            "transformations": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        },
        "config": { "type": "object" }
      },
      "additionalProperties": false
    },
    "schedule_type": { "enum": ["cron", "interval", "manual"] },
    "execution": {
      "type": "object",
      "required": ["mode", "timeout_seconds"],
      "properties": {
        "mode": { "enum": ["continuous", "scheduled", "event_driven"] },
        "schedule": {
          "type": "object",
          "properties": {
            "type": { "$ref": "#/definitions/schedule_type" },
            "cron_expression": { "type": "string" },
            "interval_seconds": { "type": "integer", "minimum": 1 },
            "timezone": { "type": "string", "default": "UTC" }
          },
          "additionalProperties": false
        },
        "event_trigger": {
          "type": "object",
          "properties": {
            "io_connector_id": { "type": "string" },
            "filters": { "type": "array", "items": { "$ref": "#/definitions/routing_filter" } },
            "batch_config": {
              "type": "object",
              "properties": {
                "min_batch_size": { "type": "integer", "minimum": 1 },
                "max_batch_size": { "type": "integer", "minimum": 1 },
                "max_wait_seconds": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "concurrency": {
          "type": "object",
          "properties": {
            "max_concurrent_jobs": { "type": "integer", "minimum": 1 },
            "max_queue_size": { "type": "integer", "minimum": 0 },
            "queue_strategy": { "enum": ["fifo", "priority"] }
          },
          "additionalProperties": false
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "state_management": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "type": { "enum": ["checkpoint", "cursor", "watermark"] },
        "storage": {
          "type": "object",
          "properties": {
            "backend": { "enum": ["postgres", "redis", "dynamodb", "sqlite"] },
            "location": { "type": "string" },
            "encryption": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "interval_seconds": { "type": "integer", "minimum": 1 },
            "on_batch_complete": { "type": "boolean", "default": true },
            "strategy": { "enum": ["incremental", "full"] }
          },
          "additionalProperties": false
        },
        "resume_on_restart": { "type": "boolean", "default": true },
        "deduplication": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "key_fields": { "type": "array", "items": { "type": "string" } },
            "window_seconds": { "type": "integer", "minimum": 1 },
            "storage": { "enum": ["redis", "postgres"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metric_condition": {
      "type": "object",
      "properties": {
        "metric_id": { "type": "string" },
        "operator": { "enum": ["gt", "gte", "lt", "lte", "eq", "neq"] },
        "threshold": { "type": "number" },
        "statistic": { "enum": ["Average", "Sum", "Minimum", "Maximum", "p50", "p90", "p95", "p99"] },
        "period_seconds": { "type": "integer", "minimum": 1 },
        "evaluation_periods": { "type": "integer", "minimum": 1 },
        "datapoints_to_trigger": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "pause_conditions": {
          "type": "object",
          "properties": {
            "$and": { "type": "array", "items": { "$ref": "#/definitions/metric_condition" } }
          },
          "additionalProperties": false
        },
        "resume_conditions": {
          "type": "object",
          "properties": {
            "$and": { "type": "array", "items": { "$ref": "#/definitions/metric_condition" } }
          },
          "additionalProperties": false
        },
        "stop_on_error": { "type": "boolean", "default": false },
        "restart_policy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "max_restarts": { "type": "integer", "minimum": 0 },
            "restart_delay_seconds": { "type": "integer", "minimum": 0 },
            "backoff_multiplier": { "type": "number", "minimum": 1 },
            "reset_after_seconds": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "check_interval_seconds": { "type": "integer", "minimum": 1 },
        "metric_ids": { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": "array", "items": { "$ref": "#/definitions/metric_condition" } },
        "notification_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "logs": { "type": "object" },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "track_metrics": { "type": "boolean", "default": true },
            "metric_ids": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "traces": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "sample_rate": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "otel_exporter": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "protocol": { "enum": ["grpc", "http", "protobuf"] },
            "headers": { "type": "object" },
            "resource_attributes": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "required_scopes": { "type": "array", "items": { "type": "string" } },
        "allowed_roles": { "type": "array", "items": { "type": "string" } },
        "allowed_actions": { "type": "object" },
        "requires_approval": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "type", "version", "status", "worker", "execution"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "type": { "$ref": "#/definitions/bg_type" },
    "version": { "type": "string" },
    "status": { "$ref": "#/definitions/status" },
    "governed_by": { "type": "string" },
    "worker": { "$ref": "#/definitions/worker" },
    "execution": { "$ref": "#/definitions/execution" },
    "io_bindings": { "type": "array", "items": { "$ref": "#/definitions/io_binding" } },
    "state_management": { "$ref": "#/definitions/state_management" },
    "lifecycle": { "$ref": "#/definitions/lifecycle" },
    "health": { "$ref": "#/definitions/health" },
    "observability": { "$ref": "#/definitions/observability" },
    "policy_ids": { "type": "array", "items": { "type": "string" } },
    "permissions": { "$ref": "#/definitions/permissions" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}

