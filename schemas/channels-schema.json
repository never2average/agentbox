{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Channels Schema",
  "description": "Validation schema for notification channels and throttling configuration",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "channel_type": {
      "enum": ["email", "sms", "push", "webhook", "slack", "pagerduty"]
    },
    "email_config": {
      "type": "object",
      "required": ["smtp_host", "smtp_port", "from_address"],
      "properties": {
        "smtp_host": { "type": "string" },
        "smtp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 587 },
        "from_address": { "$ref": "./common-schema.json#/definitions/email" },
        "subject_template": { "type": "string" },
        "use_tls": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "sms_config": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["twilio", "aws_sns"] },
        "phone_numbers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message_template": { "type": "string" }
      },
      "additionalProperties": false
    },
    "push_config": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["firebase", "apns"] },
        "device_tokens": { "type": "array", "items": { "type": "string" } },
        "title_template": { "type": "string" },
        "body_template": { "type": "string" }
      },
      "additionalProperties": false
    },
    "webhook_config": {
      "type": "object",
      "required": ["url", "method"],
      "properties": {
        "url": { "$ref": "./common-schema.json#/definitions/uri" },
        "method": { "enum": ["POST", "GET"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "auth_type": { "$ref": "./common-schema.json#/definitions/auth_type" },
        "retry_policy": { "$ref": "./common-schema.json#/definitions/retry_policy" }
      },
      "additionalProperties": false
    },
    "slack_config": {
      "type": "object",
      "required": ["webhook_url", "channel"],
      "properties": {
        "webhook_url": { "$ref": "./common-schema.json#/definitions/uri" },
        "channel": { "type": "string" },
        "username": { "type": "string" },
        "icon_emoji": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pagerduty_config": {
      "type": "object",
      "required": ["integration_key", "severity"],
      "properties": {
        "integration_key": { "type": "string" },
        "severity": { "enum": ["critical", "error", "warning", "info"] }
      },
      "additionalProperties": false
    },
    "throttling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "rate_limits": { "$ref": "./common-schema.json#/definitions/throttling_rate_limits" },
        "grouping": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "window_minutes": { "type": "integer", "minimum": 1, "default": 5 },
            "group_by": { "type": "array", "items": { "type": "string" } },
            "collapse_similar": { "type": "boolean", "default": true },
            "similarity_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
          },
          "additionalProperties": false
        },
        "deduplication": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "window_minutes": { "type": "integer", "minimum": 1, "default": 60 },
            "match_fields": { "type": "array", "items": { "type": "string" } },
            "send_reminder_after_minutes": { "type": "integer", "minimum": 1, "default": 240 }
          },
          "additionalProperties": false
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "timezone": { "type": "string", "default": "UTC" },
            "schedules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": { "$ref": "./common-schema.json#/definitions/weekday" }
                  },
                  "start_time": { "$ref": "./common-schema.json#/definitions/hh_mm_time" },
                  "end_time": { "$ref": "./common-schema.json#/definitions/hh_mm_time" },
                  "allow_critical": { "type": "boolean", "default": true }
                },
                "required": ["days", "start_time", "end_time"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "recovery_notification": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "send_when_resolved": { "type": "boolean", "default": true },
            "include_duration": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "type", "enabled", "priority", "config"],
  "properties": {
    "id": { "$ref": "./common-schema.json#/definitions/id" },
    "name": { "$ref": "./common-schema.json#/definitions/non_empty_string" },
    "type": { "$ref": "#/definitions/channel_type" },
    "enabled": { "type": "boolean", "default": true },
    "priority": { "$ref": "./common-schema.json#/definitions/priority" },
    "config": {
      "type": "object",
      "properties": {
        "email": { "$ref": "#/definitions/email_config" },
        "sms": { "$ref": "#/definitions/sms_config" },
        "push": { "$ref": "#/definitions/push_config" },
        "webhook": { "$ref": "#/definitions/webhook_config" },
        "slack": { "$ref": "#/definitions/slack_config" },
        "pagerduty": { "$ref": "#/definitions/pagerduty_config" }
      },
      "additionalProperties": false
    },
    "throttling": { "$ref": "#/definitions/throttling" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "email" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["email"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "sms" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["sms"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "push" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["push"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "webhook" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["webhook"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "slack" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["slack"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "pagerduty" } }, "required": ["type"] },
      "then": { "required": ["config"], "properties": { "config": { "required": ["pagerduty"] } } }
    }
  ],
  "additionalProperties": false,
  "examples": [
    {
      "id": "email_critical",
      "name": "Email Critical Alerts",
      "type": "email",
      "enabled": true,
      "priority": "critical",
      "config": {
        "email": {
          "smtp_host": "smtp.example.com",
          "smtp_port": 587,
          "from_address": "alerts@example.com",
          "subject_template": "[CRIT] {{subject}}",
          "use_tls": true
        }
      },
      "throttling": {
        "enabled": true,
        "rate_limits": { "max_alerts_per_minute": 2, "max_alerts_per_hour": 10, "max_alerts_per_day": 100, "burst_allowance": 5 },
        "grouping": { "enabled": true, "window_minutes": 5, "group_by": ["alert_id", "severity", "nodepool_id"], "collapse_similar": true, "similarity_threshold": 0.8 },
        "deduplication": { "enabled": true, "window_minutes": 60, "match_fields": ["alert_id", "metric_id", "threshold_breached"], "send_reminder_after_minutes": 240 },
        "recovery_notification": { "enabled": true, "send_when_resolved": true, "include_duration": true }
      }
    }
  ]
}

