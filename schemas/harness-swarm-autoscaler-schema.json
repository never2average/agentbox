{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/harness-swarm-autoscaler-schema.json",
  "title": "AgentBox HarnessSwarmAutoScaler",
  "description": "Serving-plane autoscaler for a swarm of HarnessRuntimes: scales concurrent agent harnesses on session, queue and step-latency signals.",
  "version": "2.0.0",
  "x-agentbox-crd": {
    "group": "ai.agentbox.io",
    "version": "v1beta1",
    "kind": "HarnessSwarmAutoScaler",
    "scope": "Namespaced",
    "shortNames": [
      "hsas"
    ],
    "slug": "harness-swarm-autoscaler",
    "plural": "harnessswarmautoscalers"
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common-schema.json#/definitions/apiVersion"
    },
    "kind": {
      "const": "HarnessSwarmAutoScaler"
    },
    "metadata": {
      "$ref": "common-schema.json#/definitions/objectMeta"
    },
    "spec": {
      "type": "object",
      "required": [
        "scaleTargetRef",
        "bounds",
        "metrics"
      ],
      "properties": {
        "scaleTargetRef": {
          "allOf": [
            {
              "$ref": "common-schema.json#/definitions/scaleTargetRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "HarnessRuntime"
                }
              }
            }
          ],
          "description": "HarnessRuntime whose swarm this autoscaler owns."
        },
        "bounds": {
          "$ref": "common-schema.json#/definitions/replicaBounds",
          "description": "Replica floor and ceiling for the swarm."
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common-schema.json#/definitions/scalingMetric"
          },
          "maxItems": 8,
          "description": "Signals the scaling decision reads, typically pending sessions or queue depth."
        },
        "behavior": {
          "$ref": "common-schema.json#/definitions/scalingBehavior",
          "description": "Stabilisation windows and rate limits on scale up and scale down."
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Relative deviation from target to ignore, so a metric hovering near its target does not cause churn."
        },
        "sessionAffinity": {
          "type": "object",
          "description": "How in-flight agent sessions are treated while the swarm resizes.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxSessionsPerHarness": {
              "type": "integer",
              "minimum": 1
            },
            "drainTimeoutSeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            }
          },
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set false to pause scaling without deleting the autoscaler."
        }
      },
      "additionalProperties": false,
      "x-agentbox-rules": [
        {
          "rule": "self.bounds.maxReplicas >= self.bounds.minReplicas",
          "message": "bounds.maxReplicas must be >= bounds.minReplicas"
        },
        {
          "rule": "self.scaleTargetRef.kind == 'HarnessRuntime'",
          "message": "scaleTargetRef must reference a HarnessRuntime"
        }
      ]
    },
    "status": {
      "$ref": "common-schema.json#/definitions/resourceStatus"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "apiVersion": "ai.agentbox.io/v1beta1",
      "kind": "HarnessSwarmAutoScaler",
      "metadata": {
        "name": "api-harness-swarm"
      },
      "spec": {
        "scaleTargetRef": {
          "kind": "HarnessRuntime",
          "name": "api-harness"
        },
        "bounds": {
          "minReplicas": 0,
          "maxReplicas": 50
        },
        "metrics": [
          {
            "type": "aiMetric",
            "metric": "pending-agent-sessions",
            "target": {
              "metricType": "averageValue",
              "value": 5
            }
          }
        ],
        "behavior": {
          "scaleUp": {
            "stabilizationWindowSeconds": 30
          },
          "scaleToZero": {
            "enabled": true,
            "idleSeconds": 600
          }
        },
        "sessionAffinity": {
          "enabled": true,
          "maxSessionsPerHarness": 8
        }
      }
    }
  ]
}
