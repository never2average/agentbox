{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Models Schema",
  "description": "Validation schema for model registry entries, architecture, size, and download configuration",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "model_hub": {
      "enum": ["huggingface", "s3", "gcs", "azure_blob", "custom"]
    },
    "download_api": {
      "type": "object",
      "required": ["hub_url", "api_endpoint", "download_method"],
      "properties": {
        "hub_url": { "$ref": "./common-schema.json#/definitions/uri" },
        "api_endpoint": { "$ref": "./common-schema.json#/definitions/uri" },
        "download_method": { "enum": ["huggingface_hub", "http", "s3", "gcs", "custom"] },
        "requires_auth": { "type": "boolean", "default": false },
        "auth_token_env": { "type": "string" },
        "files_to_download": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["architecture_type", "base_architecture"],
      "properties": {
        "architecture_type": { "enum": ["transformer_decoder", "transformer_encoder", "moe", "rnn", "custom"] },
        "base_architecture": { "type": "string" },
        "num_layers": { "type": "integer", "minimum": 0 },
        "num_heads": { "type": "integer", "minimum": 0 },
        "num_key_value_heads": { "type": "integer", "minimum": 0 },
        "hidden_size": { "type": "integer", "minimum": 0 },
        "intermediate_size": { "type": "integer", "minimum": 0 },
        "vocab_size": { "type": "integer", "minimum": 0 },
        "rope_theta": { "type": "number", "minimum": 0 },
        "attention_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "model_size": {
      "type": "object",
      "properties": {
        "total_params": { "type": "string" },
        "total_params_exact": { "type": "integer", "minimum": 0 },
        "disk_size_gb": { "type": "number", "minimum": 0 },
        "quantization_method": { "type": "string" },
        "quantization_precision": { "type": "string" },
        "quantization_memory_gb": { "type": "number", "minimum": 0 },
        "quantization_quality_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "context_window": {
      "type": "object",
      "properties": {
        "max_context_length": { "type": "integer", "minimum": 1 },
        "training_context_length": { "type": "integer", "minimum": 1 },
        "supports_extended_context": { "type": "boolean", "default": false },
        "rope_scaling": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "modalities": {
      "type": "object",
      "properties": {
        "input": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "required": ["model_id", "model_name", "model_hub", "hub_model_id"],
  "properties": {
    "model_id": { "type": "string" },
    "model_name": { "type": "string" },
    "model_hub": { "$ref": "#/definitions/model_hub" },
    "hub_model_id": { "type": "string" },
    "download_api": { "$ref": "#/definitions/download_api" },
    "model_architecture": { "$ref": "#/definitions/architecture" },
    "model_size": { "$ref": "#/definitions/model_size" },
    "context_window": { "$ref": "#/definitions/context_window" },
    "supports_streaming": { "type": "boolean", "default": true },
    "supports_function_calling": { "type": "boolean", "default": false },
    "modalities": { "$ref": "#/definitions/modalities" },
    "tags": { "$ref": "./common-schema.json#/definitions/tags" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "model_id": "llama-3-70b-instruct",
      "model_name": "Llama 3 70B Instruct",
      "model_hub": "huggingface",
      "hub_model_id": "meta-llama/Meta-Llama-3-70B-Instruct",
      "download_api": {
        "hub_url": "https://huggingface.co/meta-llama/Meta-Llama-3-70B-Instruct",
        "api_endpoint": "https://huggingface.co/api/models/meta-llama/Meta-Llama-3-70B-Instruct",
        "download_method": "huggingface_hub",
        "requires_auth": true,
        "auth_token_env": "HF_TOKEN",
        "files_to_download": ["*.safetensors", "config.json", "tokenizer.json", "tokenizer_config.json"]
      },
      "model_architecture": {
        "architecture_type": "transformer_decoder",
        "base_architecture": "llama",
        "num_layers": 80,
        "num_heads": 64,
        "num_key_value_heads": 8,
        "hidden_size": 8192,
        "intermediate_size": 28672,
        "vocab_size": 128256,
        "rope_theta": 500000.0,
        "attention_type": "grouped_query_attention"
      },
      "model_size": {
        "total_params": "70B",
        "total_params_exact": 70553706496,
        "disk_size_gb": 141,
        "quantization_method": "awq",
        "quantization_precision": "4bit",
        "quantization_memory_gb": 35,
        "quantization_quality_score": 0.98
      },
      "context_window": {
        "max_context_length": 8192,
        "training_context_length": 8192,
        "supports_extended_context": false,
        "rope_scaling": null
      },
      "supports_streaming": true,
      "supports_function_calling": true,
      "modalities": {
        "input": ["text"],
        "output": ["text"]
      }
    }
  ]
}

