{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/dataset-schema.json",
  "title": "AgentBox Dataset",
  "description": "Training-plane dataset: connector-backed data source/sink with cursor state and checkpointing.",
  "version": "2.0.0",
  "x-agentbox-crd": {
    "group": "ai.agentbox.io",
    "version": "v1beta1",
    "kind": "Dataset",
    "scope": "Namespaced",
    "shortNames": [
      "ds"
    ],
    "slug": "dataset",
    "plural": "datasets"
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common-schema.json#/definitions/apiVersion"
    },
    "kind": {
      "const": "Dataset"
    },
    "metadata": {
      "$ref": "common-schema.json#/definitions/objectMeta"
    },
    "spec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name"
        },
        "type": {
          "$ref": "#/definitions/connectorTypes",
          "description": "Connector type. Determines which config variant is required."
        },
        "direction": {
          "$ref": "#/definitions/direction",
          "description": "Whether this dataset is read from, written to, or both."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set false to keep the definition but stop moving data."
        },
        "config": {
          "type": "object",
          "description": "Connector configuration. Set exactly the variant matching spec.type.",
          "properties": {
            "httpPoll": {
              "$ref": "#/definitions/httpPollConfig"
            },
            "webhook": {
              "$ref": "#/definitions/webhookConfig"
            },
            "kafka": {
              "$ref": "#/definitions/kafkaConfig"
            },
            "queue": {
              "$ref": "#/definitions/queueConfig"
            },
            "s3": {
              "$ref": "#/definitions/s3Config"
            },
            "fs": {
              "$ref": "#/definitions/fsConfig"
            },
            "database": {
              "$ref": "#/definitions/databaseConfig"
            },
            "grpc": {
              "$ref": "#/definitions/grpcConfig"
            },
            "pubsub": {
              "$ref": "#/definitions/pubsubConfig"
            }
          },
          "additionalProperties": false
        },
        "stateManagement": {
          "$ref": "#/definitions/stateManagement",
          "description": "Cursor and checkpoint behaviour for incremental reads."
        },
        "metadata": {
          "$ref": "#/definitions/metadata",
          "description": "Free-form annotations."
        }
      },
      "required": [
        "name",
        "type",
        "direction",
        "enabled",
        "config"
      ],
      "additionalProperties": false,
      "x-agentbox-rules": [
        {
          "rule": "[has(self.config.httpPoll), has(self.config.webhook), has(self.config.kafka), has(self.config.queue), has(self.config.s3), has(self.config.fs), has(self.config.database), has(self.config.grpc), has(self.config.pubsub)].filter(x, x).size() == 1",
          "message": "exactly one config variant must be set"
        },
        {
          "rule": "self.type != 'httpPoll' || has(self.config.httpPoll)",
          "message": "config.httpPoll is required when type is httpPoll"
        },
        {
          "rule": "self.type != 'webhook' || has(self.config.webhook)",
          "message": "config.webhook is required when type is webhook"
        },
        {
          "rule": "self.type != 'kafka' || has(self.config.kafka)",
          "message": "config.kafka is required when type is kafka"
        },
        {
          "rule": "self.type != 'queue' || has(self.config.queue)",
          "message": "config.queue is required when type is queue"
        },
        {
          "rule": "self.type != 's3' || has(self.config.s3)",
          "message": "config.s3 is required when type is s3"
        },
        {
          "rule": "self.type != 'fs' || has(self.config.fs)",
          "message": "config.fs is required when type is fs"
        },
        {
          "rule": "self.type != 'database' || has(self.config.database)",
          "message": "config.database is required when type is database"
        },
        {
          "rule": "self.type != 'grpc' || has(self.config.grpc)",
          "message": "config.grpc is required when type is grpc"
        },
        {
          "rule": "self.type != 'pubsub' || has(self.config.pubsub)",
          "message": "config.pubsub is required when type is pubsub"
        }
      ]
    },
    "status": {
      "$ref": "common-schema.json#/definitions/resourceStatus"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "connectorTypes": {
      "enum": [
        "httpPoll",
        "webhook",
        "kafka",
        "queue",
        "s3",
        "fs",
        "database",
        "grpc",
        "pubsub"
      ],
      "description": "Connector types with a config schema. One config variant per type."
    },
    "direction": {
      "enum": [
        "source",
        "sink",
        "both"
      ],
      "description": "Data flow direction - source (inbound), sink (outbound), or both (bidirectional)"
    },
    "stateManagementType": {
      "enum": [
        "cursor",
        "offset",
        "watermark",
        "receiptHandle",
        "fileTracker",
        "ackId",
        "streamPosition",
        "checkpoint",
        "none"
      ],
      "description": "Type of state management strategy for the connector"
    },
    "storageBackend": {
      "enum": [
        "memory",
        "persistent",
        "kafka",
        "dynamodb",
        "sqlite",
        "postgres",
        "mysql",
        "redis",
        "etcd",
        "firestore",
        "mongodb",
        "cassandra",
        "none"
      ],
      "description": "Backend storage system for state persistence"
    },
    "authType": {
      "enum": [
        "none",
        "bearer",
        "basic",
        "apiKey",
        "oauth2",
        "jwt",
        "hmac",
        "iamRole",
        "serviceAccount",
        "mutualTls",
        "sasl"
      ],
      "description": "Authentication mechanism types"
    },
    "httpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ],
      "description": "HTTP request methods"
    },
    "checkpointStrategy": {
      "enum": [
        "incremental",
        "full",
        "commitSync",
        "commitAsync",
        "transactional",
        "deleteOnSuccess",
        "markProcessed",
        "ackOnSuccess",
        "ackBased",
        "none"
      ],
      "description": "Strategy for checkpointing processed data"
    },
    "authConfig": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/authType"
        },
        "bearerToken": {
          "type": "string",
          "description": "Bearer token (use secret:// ref in production)"
        },
        "apiKey": {
          "type": "string",
          "description": "API key (use secret:// ref in production)"
        },
        "apiKeyHeader": {
          "type": "string",
          "default": "X-API-Key"
        },
        "username": {
          "type": "string"
        },
        "passwordRef": {
          "type": "string",
          "pattern": "^secret://",
          "description": "Reference to secret storage"
        },
        "credentialsRef": {
          "type": "string",
          "pattern": "^secret://",
          "description": "Reference to credential file or secret"
        },
        "secretRef": {
          "type": "string",
          "pattern": "^secret://"
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::"
        },
        "oauth2": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string"
            },
            "clientSecretRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "grantType": {
              "enum": [
                "clientCredentials",
                "authorizationCode",
                "refreshToken"
              ]
            }
          }
        }
      }
    },
    "stateManagement": {
      "type": "object",
      "required": [
        "enabled",
        "type"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable state management for fault tolerance"
        },
        "type": {
          "$ref": "#/definitions/stateManagementType"
        },
        "storage": {
          "type": "object",
          "required": [
            "backend"
          ],
          "properties": {
            "backend": {
              "$ref": "#/definitions/storageBackend"
            },
            "location": {
              "type": "string",
              "description": "Storage location (path, table name, key prefix, etc.)"
            },
            "encryption": {
              "type": "boolean",
              "default": false,
              "description": "Enable encryption at rest"
            },
            "connection": {
              "type": "object",
              "description": "Connection details for storage backend"
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Checkpoint interval in seconds"
            },
            "onBatchComplete": {
              "type": "boolean",
              "default": true,
              "description": "Checkpoint after each batch completes"
            },
            "strategy": {
              "$ref": "#/definitions/checkpointStrategy"
            }
          }
        },
        "cursor": {
          "type": "object",
          "description": "Cursor-based state tracking (for http_poll, database)",
          "properties": {
            "field": {
              "type": "string",
              "description": "Field name to track (e.g., 'last_modified', 'id')"
            },
            "initialValue": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "Starting cursor value"
            },
            "format": {
              "enum": [
                "iso8601",
                "unixTimestamp",
                "integer",
                "string"
              ],
              "description": "Cursor value format"
            }
          }
        },
        "offset": {
          "type": "object",
          "description": "Offset-based state tracking (for Kafka, Kinesis)",
          "properties": {
            "commitMode": {
              "enum": [
                "auto",
                "manual",
                "sync",
                "async"
              ],
              "default": "manual"
            },
            "autoCommitIntervalMs": {
              "type": "integer",
              "default": 5000
            },
            "resetPolicy": {
              "enum": [
                "earliest",
                "latest",
                "none"
              ],
              "default": "latest"
            }
          }
        },
        "watermark": {
          "type": "object",
          "description": "Watermark-based state tracking (for databases)",
          "properties": {
            "column": {
              "type": "string",
              "description": "Column to track (e.g., 'id', 'updated_at')"
            },
            "type": {
              "enum": [
                "incremental",
                "timestamp",
                "composite"
              ],
              "default": "incremental"
            },
            "initialValue": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "fallbackColumn": {
              "type": "string",
              "description": "Fallback column if primary is null"
            }
          }
        },
        "visibility": {
          "type": "object",
          "description": "Visibility timeout management (for queue systems)",
          "properties": {
            "trackingEnabled": {
              "type": "boolean",
              "default": true
            },
            "extendOnProcessing": {
              "type": "boolean",
              "default": true
            },
            "extensionSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            }
          }
        },
        "fileTracking": {
          "type": "object",
          "description": "File tracking for filesystem/S3 connectors",
          "properties": {
            "trackBy": {
              "enum": [
                "etag",
                "inodeMtime",
                "hash",
                "pathMtime"
              ],
              "description": "What to use for tracking file changes"
            },
            "storeMetadata": {
              "type": "boolean",
              "default": true
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Metadata fields to store"
            }
          }
        },
        "ackManagement": {
          "type": "object",
          "description": "Acknowledgment management (for Pub/Sub)",
          "properties": {
            "deadlineExtensionEnabled": {
              "type": "boolean",
              "default": true
            },
            "extensionIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "maxExtensionCount": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          }
        },
        "streamPosition": {
          "type": "object",
          "description": "Stream position tracking (for gRPC, WebSocket)",
          "properties": {
            "tokenType": {
              "enum": [
                "opaque",
                "sequence",
                "timestamp"
              ],
              "description": "Type of position token"
            },
            "resumeEnabled": {
              "type": "boolean",
              "default": true
            },
            "bufferSize": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            }
          }
        },
        "deduplication": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable deduplication of messages/records"
            },
            "keyFields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Fields to use for deduplication key"
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 60,
              "description": "Deduplication window duration"
            },
            "storage": {
              "$ref": "#/definitions/storageBackend"
            }
          }
        },
        "exactlyOnce": {
          "type": "object",
          "description": "Exactly-once delivery semantics",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "enum": [
                "idempotencyKey",
                "transactionalOutbox",
                "twoPhaseCommit",
                "pubsubExactlyOnceDelivery",
                "kafkaTransactions"
              ]
            },
            "isolationLevel": {
              "enum": [
                "readUncommitted",
                "readCommitted"
              ],
              "description": "For Kafka transactions"
            },
            "transactionalId": {
              "type": "string",
              "description": "For Kafka transactions"
            },
            "idempotencyTable": {
              "type": "string",
              "description": "Table for idempotency tracking"
            },
            "outboxTable": {
              "type": "string",
              "description": "Table for transactional outbox pattern"
            },
            "ttlSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "headerName": {
              "type": "string",
              "description": "Header name for idempotency key"
            },
            "pollingIntervalMs": {
              "type": "integer",
              "minimum": 10
            },
            "enableOrdering": {
              "type": "boolean"
            }
          }
        },
        "resume": {
          "type": "object",
          "description": "Resume capability for large file transfers",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "chunkSizeBytes": {
              "type": "integer",
              "minimum": 1024
            },
            "multipartThresholdBytes": {
              "type": "integer",
              "minimum": 1048576
            },
            "checkpointIntervalBytes": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "changeDataCapture": {
          "type": "object",
          "description": "CDC configuration for databases",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "enum": [
                "logicalReplication",
                "triggerBased",
                "logBased",
                "queryBased"
              ]
            },
            "slotName": {
              "type": "string"
            },
            "publication": {
              "type": "string"
            }
          }
        },
        "deadLetter": {
          "type": "object",
          "description": "Dead letter queue/topic configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "maxDeliveryAttempts": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "dlqUrl": {
              "type": "string",
              "description": "Dead letter queue URL (for SQS)"
            },
            "dlqTopic": {
              "type": "string",
              "description": "Dead letter topic (for Pub/Sub, Kafka)"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "httpPollConfig": {
      "type": "object",
      "required": [
        "url",
        "method",
        "intervalSeconds"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "$ref": "#/definitions/httpMethod"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "queryParams": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "body": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Polling interval in seconds"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        },
        "responseFormat": {
          "enum": [
            "json",
            "xml",
            "csv",
            "text",
            "binary"
          ],
          "default": "json"
        },
        "pagination": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "enum": [
                "offset",
                "cursor",
                "page",
                "linkHeader"
              ]
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "webhookConfig": {
      "type": "object",
      "required": [
        "path",
        "method"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "method": {
          "oneOf": [
            {
              "$ref": "#/definitions/httpMethod"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/httpMethod"
              }
            }
          ]
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        },
        "validation": {
          "type": "object",
          "properties": {
            "verifySignature": {
              "type": "boolean",
              "default": false
            },
            "signatureHeader": {
              "type": "string"
            },
            "allowedIps": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "ipv4"
              }
            },
            "rateLimitPerIp": {
              "type": "integer",
              "minimum": 1
            },
            "maxBodySizeBytes": {
              "type": "integer",
              "minimum": 1,
              "default": 1048576
            }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "sync": {
              "type": "boolean",
              "default": false,
              "description": "Return response synchronously after processing"
            },
            "statusCode": {
              "type": "integer",
              "default": 200
            },
            "body": {
              "type": [
                "object",
                "string"
              ]
            }
          }
        }
      }
    },
    "kafkaConfig": {
      "type": "object",
      "required": [
        "brokers",
        "topics"
      ],
      "properties": {
        "brokers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "topics": {
          "type": "object",
          "properties": {
            "consume": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "produce": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "consumerGroup": {
          "type": "string"
        },
        "producer": {
          "type": "object",
          "properties": {
            "acks": {
              "enum": [
                "0",
                "1",
                "all"
              ],
              "default": "all"
            },
            "compression": {
              "enum": [
                "none",
                "gzip",
                "snappy",
                "lz4",
                "zstd"
              ],
              "default": "snappy"
            },
            "idempotence": {
              "type": "boolean",
              "default": true
            },
            "maxInFlight": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1
            },
            "lingerMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "consumer": {
          "type": "object",
          "properties": {
            "offsetReset": {
              "enum": [
                "earliest",
                "latest",
                "none"
              ],
              "default": "latest"
            },
            "autoCommit": {
              "type": "boolean",
              "default": false
            },
            "maxPollRecords": {
              "type": "integer",
              "minimum": 1,
              "default": 500
            },
            "sessionTimeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "default": 30000
            },
            "heartbeatIntervalMs": {
              "type": "integer",
              "minimum": 1000
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "protocol": {
              "enum": [
                "PLAINTEXT",
                "SSL",
                "SASL_PLAINTEXT",
                "SASL_SSL"
              ],
              "default": "PLAINTEXT"
            },
            "sasl": {
              "type": "object",
              "properties": {
                "mechanism": {
                  "enum": [
                    "PLAIN",
                    "SCRAM-SHA-256",
                    "SCRAM-SHA-512",
                    "GSSAPI"
                  ],
                  "default": "SCRAM-SHA-512"
                },
                "username": {
                  "type": "string"
                },
                "passwordRef": {
                  "type": "string",
                  "pattern": "^secret://"
                }
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "caCertRef": {
                  "type": "string",
                  "pattern": "^secret://"
                },
                "clientCertRef": {
                  "type": "string",
                  "pattern": "^secret://"
                },
                "clientKeyRef": {
                  "type": "string",
                  "pattern": "^secret://"
                },
                "verifyHostname": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        }
      }
    },
    "queueConfig": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "sqs",
            "azureQueue",
            "rabbitmq",
            "redis"
          ],
          "description": "Queue service provider"
        },
        "queueUrl": {
          "type": "string",
          "description": "Queue URL (for SQS, Azure)"
        },
        "queueName": {
          "type": "string",
          "description": "Queue name (for RabbitMQ, Redis)"
        },
        "region": {
          "type": "string",
          "description": "AWS/Azure region"
        },
        "receive": {
          "type": "object",
          "properties": {
            "maxMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            },
            "waitTimeSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 20
            },
            "visibilityTimeoutSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 43200,
              "default": 300
            }
          }
        },
        "send": {
          "type": "object",
          "properties": {
            "messageGroupId": {
              "type": "string"
            },
            "deduplicationIdStrategy": {
              "enum": [
                "contentBased",
                "messageId",
                "custom"
              ],
              "default": "contentBased"
            },
            "delaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 900
            }
          }
        },
        "dlq": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "maxReceiveCount": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "dlqUrl": {
              "type": "string"
            }
          }
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        }
      }
    },
    "s3Config": {
      "type": "object",
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "prefix": {
          "type": "string",
          "description": "S3 key prefix/folder"
        },
        "read": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "File pattern to match (glob)"
            },
            "pollIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 300
            },
            "deleteAfterRead": {
              "type": "boolean",
              "default": false
            },
            "recursive": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "keyPattern": {
              "type": "string",
              "description": "S3 key pattern with variables like {year}/{month}/{day}/{uuid}"
            },
            "storageClass": {
              "enum": [
                "STANDARD",
                "STANDARD_IA",
                "ONEZONE_IA",
                "INTELLIGENT_TIERING",
                "GLACIER",
                "DEEP_ARCHIVE"
              ],
              "default": "STANDARD"
            },
            "acl": {
              "enum": [
                "private",
                "public-read",
                "public-read-write",
                "authenticated-read"
              ],
              "default": "private"
            },
            "encryption": {
              "enum": [
                "none",
                "AES256",
                "aws:kms"
              ],
              "default": "AES256"
            },
            "kmsKeyId": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        }
      }
    },
    "fsConfig": {
      "type": "object",
      "required": [
        "basePath"
      ],
      "properties": {
        "basePath": {
          "type": "string",
          "description": "Base directory path"
        },
        "read": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "File pattern to match (glob)"
            },
            "pollIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            },
            "deleteAfterRead": {
              "type": "boolean",
              "default": false
            },
            "recursive": {
              "type": "boolean",
              "default": false
            },
            "followSymlinks": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "pathPattern": {
              "type": "string",
              "description": "File path pattern with variables"
            },
            "createDirs": {
              "type": "boolean",
              "default": true
            },
            "permissions": {
              "type": "string",
              "pattern": "^0[0-7]{3}$",
              "default": "0644"
            },
            "rotation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "strategy": {
                  "enum": [
                    "size",
                    "time",
                    "both"
                  ],
                  "default": "size"
                },
                "maxSizeBytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "maxAgeSeconds": {
                  "type": "integer",
                  "minimum": 60
                },
                "maxFiles": {
                  "type": "integer",
                  "minimum": 1
                },
                "compress": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "databaseConfig": {
      "type": "object",
      "required": [
        "driver",
        "connection"
      ],
      "properties": {
        "driver": {
          "enum": [
            "postgres",
            "mysql",
            "mariadb",
            "mssql",
            "oracle",
            "mongodb",
            "cassandra",
            "clickhouse"
          ],
          "description": "Database driver/type"
        },
        "connection": {
          "type": "object",
          "required": [
            "host",
            "database"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "passwordRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "sslMode": {
              "enum": [
                "disable",
                "require",
                "verify-ca",
                "verify-full"
              ],
              "default": "require"
            },
            "pool": {
              "type": "object",
              "properties": {
                "minSize": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 2
                },
                "maxSize": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 10
                },
                "maxIdleTimeSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 300
                },
                "maxLifetimeSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 3600
                }
              }
            }
          }
        },
        "read": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "SQL query to fetch records"
            },
            "pollIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "markProcessed": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "updateQuery": {
                  "type": "string"
                },
                "updateField": {
                  "type": "string"
                }
              }
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "insert",
                "upsert",
                "update",
                "replace"
              ],
              "default": "insert"
            },
            "conflictColumns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "batchTimeoutMs": {
              "type": "integer",
              "minimum": 10,
              "default": 1000
            }
          }
        }
      }
    },
    "grpcConfig": {
      "type": "object",
      "required": [
        "endpoint",
        "service"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "gRPC server endpoint (host:port)"
        },
        "service": {
          "type": "string",
          "description": "Fully qualified service name"
        },
        "methods": {
          "type": "object",
          "properties": {
            "read": {
              "type": "string",
              "description": "Method for reading/streaming"
            },
            "write": {
              "type": "string",
              "description": "Method for writing"
            }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "insecureSkipVerify": {
              "type": "boolean",
              "default": false
            },
            "caCertRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "clientCertRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "clientKeyRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "serverNameOverride": {
              "type": "string"
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "gRPC metadata headers"
        },
        "keepalive": {
          "type": "object",
          "properties": {
            "timeSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "permitWithoutStream": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "maxReceiveMessageSizeMb": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "maxSendMessageSizeMb": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        }
      }
    },
    "pubsubConfig": {
      "type": "object",
      "required": [
        "provider",
        "projectId"
      ],
      "properties": {
        "provider": {
          "enum": [
            "gcp",
            "azure",
            "awsSns"
          ],
          "description": "Pub/Sub provider"
        },
        "projectId": {
          "type": "string",
          "description": "GCP project ID or equivalent"
        },
        "subscription": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "ackDeadlineSeconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 600,
              "default": 60
            },
            "maxOutstandingMessages": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "maxOutstandingBytes": {
              "type": "integer",
              "minimum": 1024,
              "default": 104857600
            }
          }
        },
        "publisher": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string"
            },
            "batch": {
              "type": "object",
              "properties": {
                "maxMessages": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 100
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "default": 1048576
                },
                "delayThresholdMs": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 100
                }
              }
            },
            "orderingKey": {
              "type": "string"
            },
            "enableMessageOrdering": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "auth": {
          "$ref": "#/definitions/authConfig"
        }
      }
    }
  },
  "examples": [
    {
      "apiVersion": "ai.agentbox.io/v1beta1",
      "kind": "Dataset",
      "metadata": {
        "name": "orders-stream"
      },
      "spec": {
        "name": "Orders API Polling",
        "type": "httpPoll",
        "direction": "source",
        "enabled": true,
        "config": {
          "httpPoll": {
            "url": "https://api.example.com/orders",
            "method": "GET",
            "intervalSeconds": 60
          }
        }
      }
    }
  ]
}
