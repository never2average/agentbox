{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/model-schema.json",
  "title": "AgentBox Model",
  "description": "Serving-plane model: registry entry, weights source, architecture and runtime capabilities.",
  "version": "2.0.0",
  "x-agentbox-crd": {
    "group": "ai.agentbox.io",
    "version": "v1beta1",
    "kind": "Model",
    "scope": "Namespaced",
    "shortNames": [
      "mdl"
    ],
    "slug": "model",
    "plural": "models"
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common-schema.json#/definitions/apiVersion"
    },
    "kind": {
      "const": "Model"
    },
    "metadata": {
      "$ref": "common-schema.json#/definitions/objectMeta"
    },
    "spec": {
      "type": "object",
      "properties": {
        "modelName": {
          "type": "string",
          "description": "Human-readable model name, as callers refer to it."
        },
        "modelHub": {
          "$ref": "#/definitions/modelHub",
          "description": "Where the weights live."
        },
        "hubModelId": {
          "type": "string",
          "description": "Model identifier within the hub, e.g. meta-llama/Meta-Llama-3-70B-Instruct."
        },
        "downloadApi": {
          "$ref": "#/definitions/downloadApi",
          "description": "How the platform fetches the weights, including auth."
        },
        "modelArchitecture": {
          "$ref": "#/definitions/architecture",
          "description": "Architecture family and layer/head geometry."
        },
        "modelSize": {
          "$ref": "#/definitions/modelSize",
          "description": "Parameter count and on-disk footprint, used for placement."
        },
        "contextWindow": {
          "$ref": "#/definitions/contextWindow",
          "description": "Maximum context and output length the model supports."
        },
        "supportsStreaming": {
          "type": "boolean",
          "default": true,
          "description": "Whether the model can stream tokens."
        },
        "supportsFunctionCalling": {
          "type": "boolean",
          "default": false,
          "description": "Whether the model supports tool/function calling."
        },
        "modalities": {
          "$ref": "#/definitions/modalities",
          "description": "Input and output modalities the model accepts."
        },
        "tags": {
          "$ref": "./common-schema.json#/definitions/tags",
          "description": "Free-form labels for discovery."
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 1,
          "description": "Serving replicas. Ignored while a ModelAutoScaler owns this model."
        },
        "serving": {
          "type": "object",
          "description": "How to serve this model in-cluster. Omit for a registry-only entry that records what the model is without running anything.",
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9._\\-/]*[a-z0-9])?(:[\\w][\\w.\\-]{0,127})?(@sha256:[a-f0-9]{64})?$"
            },
            "entrypoint": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 8000
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "compute": {
              "$ref": "common-schema.json#/definitions/computeResources"
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Node labels the serving pods must land on, e.g. a GPU node group."
            },
            "health": {
              "$ref": "#/definitions/health"
            },
            "files": {
              "type": "object",
              "description": "Files written into the container from a ConfigMap or Secret. The key is the mount path.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "$ref": "common-schema.json#/definitions/dnsName",
                    "description": "ConfigMap or Secret name in the same namespace."
                  },
                  "kind": {
                    "enum": [
                      "ConfigMap",
                      "Secret"
                    ],
                    "default": "ConfigMap"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "modelName",
        "modelHub",
        "hubModelId"
      ],
      "additionalProperties": false,
      "x-agentbox-rules": [
        {
          "rule": "!has(self.serving) || self.serving.image != ''",
          "message": "serving.image is required when serving is set"
        }
      ]
    },
    "status": {
      "$ref": "common-schema.json#/definitions/resourceStatus"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "modelHub": {
      "enum": [
        "huggingface",
        "s3",
        "gcs",
        "azureBlob",
        "custom"
      ]
    },
    "downloadApi": {
      "type": "object",
      "required": [
        "hubUrl",
        "apiEndpoint",
        "downloadMethod"
      ],
      "properties": {
        "hubUrl": {
          "$ref": "./common-schema.json#/definitions/uri"
        },
        "apiEndpoint": {
          "$ref": "./common-schema.json#/definitions/uri"
        },
        "downloadMethod": {
          "enum": [
            "huggingfaceHub",
            "http",
            "s3",
            "gcs",
            "custom"
          ]
        },
        "requiresAuth": {
          "type": "boolean",
          "default": false
        },
        "authTokenEnv": {
          "type": "string"
        },
        "filesToDownload": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": [
        "architectureType",
        "baseArchitecture"
      ],
      "properties": {
        "architectureType": {
          "enum": [
            "transformerDecoder",
            "transformerEncoder",
            "moe",
            "rnn",
            "custom"
          ]
        },
        "baseArchitecture": {
          "type": "string"
        },
        "numLayers": {
          "type": "integer",
          "minimum": 0
        },
        "numHeads": {
          "type": "integer",
          "minimum": 0
        },
        "numKeyValueHeads": {
          "type": "integer",
          "minimum": 0
        },
        "hiddenSize": {
          "type": "integer",
          "minimum": 0
        },
        "intermediateSize": {
          "type": "integer",
          "minimum": 0
        },
        "vocabSize": {
          "type": "integer",
          "minimum": 0
        },
        "ropeTheta": {
          "type": "number",
          "minimum": 0
        },
        "attentionType": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "modelSize": {
      "type": "object",
      "properties": {
        "totalParams": {
          "type": "string"
        },
        "totalParamsExact": {
          "type": "integer",
          "minimum": 0
        },
        "diskSizeGb": {
          "type": "number",
          "minimum": 0
        },
        "quantizationMethod": {
          "type": "string"
        },
        "quantizationPrecision": {
          "type": "string"
        },
        "quantizationMemoryGb": {
          "type": "number",
          "minimum": 0
        },
        "quantizationQualityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "contextWindow": {
      "type": "object",
      "properties": {
        "maxContextLength": {
          "type": "integer",
          "minimum": 1
        },
        "trainingContextLength": {
          "type": "integer",
          "minimum": 1
        },
        "supportsExtendedContext": {
          "type": "boolean",
          "default": false
        },
        "ropeScaling": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "modalities": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "http",
            "tcp",
            "exec"
          ],
          "default": "http"
        },
        "path": {
          "type": "string",
          "default": "/healthz"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "apiVersion": "ai.agentbox.io/v1beta1",
      "kind": "Model",
      "metadata": {
        "name": "llama-3-70b-instruct"
      },
      "spec": {
        "modelName": "Llama 3 70B Instruct",
        "modelHub": "huggingface",
        "hubModelId": "meta-llama/Meta-Llama-3-70B-Instruct"
      }
    }
  ]
}
