{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/harness-runtime-schema.json",
  "title": "AgentBox HarnessRuntime",
  "description": "Serving-plane agent harness: runs a developer-supplied image as a Kubernetes workload with the compute, endpoints and health it declares. What the agent talks to - models, gateways, tool servers, data - is the image's business at runtime.",
  "version": "2.0.0",
  "x-agentbox-crd": {
    "group": "ai.agentbox.io",
    "version": "v1beta1",
    "kind": "HarnessRuntime",
    "scope": "Namespaced",
    "shortNames": [
      "hr"
    ],
    "slug": "harness-runtime",
    "plural": "harnessruntimes"
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common-schema.json#/definitions/apiVersion"
    },
    "kind": {
      "const": "HarnessRuntime"
    },
    "metadata": {
      "$ref": "common-schema.json#/definitions/objectMeta"
    },
    "spec": {
      "type": "object",
      "required": [
        "runtimeKind",
        "code"
      ],
      "properties": {
        "runtimeKind": {
          "$ref": "#/definitions/runtimeKind",
          "description": "Workload shape backing this harness."
        },
        "code": {
          "$ref": "#/definitions/code",
          "description": "The developer-supplied image to run."
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Desired replicas. Ignored while a HarnessSwarmAutoScaler owns this harness.",
          "maximum": 10000
        },
        "compute": {
          "$ref": "common-schema.json#/definitions/computeResources",
          "description": "CPU, memory, GPU and storage requested per replica."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables passed to the image. Secret-looking values are moved into a Secret."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/endpoint"
          },
          "maxItems": 16,
          "description": "Ports the harness serves on. A Service is created for these."
        },
        "schedule": {
          "$ref": "#/definitions/schedule",
          "description": "Only meaningful when runtime_kind is cron."
        },
        "health": {
          "$ref": "#/definitions/health",
          "description": "Readiness probe for the harness container."
        },
        "files": {
          "type": "object",
          "description": "Files written into the container from a ConfigMap or Secret. The key is the mount path.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "common-schema.json#/definitions/dnsName",
                "description": "ConfigMap or Secret name in the same namespace."
              },
              "kind": {
                "enum": [
                  "ConfigMap",
                  "Secret"
                ],
                "default": "ConfigMap"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "x-agentbox-rules": [
        {
          "rule": "self.runtimeKind != 'cron' || has(self.schedule)",
          "message": "schedule is required when runtimeKind is cron"
        },
        {
          "rule": "self.runtimeKind != 'server' || (has(self.endpoints) && self.endpoints.size() > 0)",
          "message": "a server harness must declare at least one endpoint"
        },
        {
          "rule": "!has(self.health) || self.health.type != 'exec' || has(self.health.command)",
          "message": "health.command is required when health.type is exec"
        },
        {
          "rule": "!has(self.env) || self.env.all(k, k.matches('^[A-Za-z_][A-Za-z0-9_]*$'))",
          "message": "env keys must be valid environment variable names"
        }
      ]
    },
    "status": {
      "$ref": "common-schema.json#/definitions/resourceStatus"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "runtimeKind": {
      "enum": [
        "server",
        "worker",
        "batch",
        "cron"
      ]
    },
    "code": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9._\\-/]*[a-z0-9])?(:[\\w][\\w.\\-]{0,127})?(@sha256:[a-f0-9]{64})?$"
        },
        "entrypoint": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": [
        "name",
        "port"
      ],
      "properties": {
        "name": {
          "$ref": "common-schema.json#/definitions/dnsName"
        },
        "interface": {
          "enum": [
            "http",
            "grpc",
            "websocket"
          ],
          "default": "http"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "default": "/",
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "cronExpression"
      ],
      "properties": {
        "cronExpression": {
          "type": "string",
          "pattern": "^(@(annually|yearly|monthly|weekly|daily|hourly)|((\\*|[0-9,\\-*/]+)\\s+){4}(\\*|[0-9,\\-*/]+))$"
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "http",
            "tcp",
            "exec"
          ],
          "default": "http"
        },
        "path": {
          "type": "string",
          "default": "/healthz"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "apiVersion": "ai.agentbox.io/v1beta1",
      "kind": "HarnessRuntime",
      "metadata": {
        "name": "api-harness",
        "labels": {
          "app.kubernetes.io/version": "1.4.0"
        }
      },
      "spec": {
        "runtimeKind": "server",
        "code": {
          "image": "acme/support-agent:1.4.0",
          "entrypoint": "/app/serve"
        },
        "replicas": 2,
        "compute": {
          "cpu": {
            "cores": 4,
            "memoryMb": 8192
          }
        },
        "endpoints": [
          {
            "name": "api",
            "interface": "http",
            "port": 8080,
            "path": "/api"
          }
        ],
        "health": {
          "type": "http",
          "path": "/healthz",
          "port": 8080
        }
      }
    }
  ]
}
