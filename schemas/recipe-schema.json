{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/recipe-schema.json",
  "title": "AgentBox Recipe",
  "description": "Composable pipeline definition (data processing, training, context management, workflow).",
  "version": "2.0.0",
  "x-agentbox-crd": {
    "group": "ai.agentbox.io",
    "version": "v1beta1",
    "kind": "Recipe",
    "scope": "Namespaced",
    "shortNames": [
      "rcp"
    ],
    "slug": "recipe",
    "plural": "recipes"
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common-schema.json#/definitions/apiVersion"
    },
    "kind": {
      "const": "Recipe"
    },
    "metadata": {
      "$ref": "common-schema.json#/definitions/objectMeta"
    },
    "spec": {
      "type": "object",
      "properties": {
        "coreMetadata": {
          "$ref": "#/definitions/coreMetadata",
          "description": "Identity of the recipe: type, version and lifecycle status."
        },
        "ioSpecification": {
          "$ref": "#/definitions/ioSpecification",
          "description": "Input and output contracts for the pipeline."
        },
        "executionDefinition": {
          "$ref": "#/definitions/executionDefinition",
          "description": "Ordered stages and their dependencies."
        },
        "runtimeConfiguration": {
          "type": "object",
          "properties": {
            "stateManagement": {
              "$ref": "#/definitions/stateManagement"
            },
            "concurrency": {
              "$ref": "#/definitions/concurrency"
            },
            "resourceRequirements": {
              "$ref": "#/definitions/resourceRequirements"
            }
          },
          "additionalProperties": false,
          "description": "State, concurrency and resources for a run."
        },
        "optimization": {
          "$ref": "#/definitions/optimization",
          "description": "Caching, batching and other execution optimisations."
        },
        "observability": {
          "$ref": "#/definitions/observability",
          "description": "Logging, tracing and metric emission for runs."
        },
        "operational": {
          "$ref": "#/definitions/operational",
          "description": "Timeouts, retries and failure handling."
        },
        "dependencies": {
          "$ref": "#/definitions/dependencies",
          "description": "Other recipes or resources this one needs."
        },
        "metadata": {
          "$ref": "#/definitions/meta",
          "description": "Free-form annotations."
        }
      },
      "required": [
        "coreMetadata",
        "executionDefinition"
      ],
      "additionalProperties": false
    },
    "status": {
      "$ref": "common-schema.json#/definitions/resourceStatus"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "recipeType": {
      "enum": [
        "dataProcessing",
        "modelTraining",
        "contextManagement",
        "workflow",
        "custom"
      ]
    },
    "status": {
      "enum": [
        "active",
        "inactive",
        "deprecated",
        "draft"
      ]
    },
    "coreMetadata": {
      "type": "object",
      "required": [
        "description",
        "type",
        "version",
        "status"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/recipeType"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/status"
        }
      },
      "additionalProperties": false
    },
    "ioSchema": {
      "type": "object"
    },
    "ioSpecification": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/definitions/ioSchema"
            },
            "validation": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean",
                  "default": true
                },
                "allowAdditionalProperties": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/definitions/ioSchema"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "ingest",
            "transform",
            "train",
            "evaluate",
            "export",
            "custom"
          ]
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "params": {
          "type": "object"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "executionDefinition": {
      "type": "object",
      "required": [
        "stages"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/stage"
          }
        }
      },
      "additionalProperties": false
    },
    "stateManagement": {
      "type": "object",
      "properties": {
        "persistent": {
          "type": "boolean",
          "default": false
        },
        "storageBackend": {
          "$ref": "./common-schema.json#/definitions/storageBackend"
        },
        "checkpointStrategy": {
          "enum": [
            "stageCompletion",
            "timeInterval",
            "none"
          ]
        },
        "checkpointIntervalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resumable": {
          "type": "boolean",
          "default": false
        },
        "resumeFrom": {
          "type": "string"
        },
        "stateSchema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "maxConcurrentExecutions": {
          "type": "integer",
          "minimum": 1
        },
        "executionMode": {
          "enum": [
            "sequential",
            "parallel",
            "hybrid"
          ]
        },
        "isolationLevel": {
          "type": "string"
        },
        "locking": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "resourceRequirements": {
      "type": "object",
      "properties": {
        "compute": {
          "type": "object"
        },
        "storage": {
          "type": "object"
        },
        "network": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "optimization": {
      "type": "object",
      "properties": {
        "caching": {
          "type": "object"
        },
        "performanceOptimization": {
          "type": "object"
        },
        "costOptimization": {
          "type": "object"
        },
        "continuousImprovement": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "traces": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "operational": {
      "type": "object",
      "properties": {
        "monitoring": {
          "type": "object"
        },
        "scheduling": {
          "type": "object"
        },
        "costTracking": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "requiredIoConnectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredAgents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredRuntimes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalConnectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "createdAt": {
          "$ref": "./common-schema.json#/definitions/isoDatetime"
        },
        "updatedAt": {
          "$ref": "./common-schema.json#/definitions/isoDatetime"
        },
        "createdBy": {
          "type": "string"
        },
        "versionHistory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "$ref": "./common-schema.json#/definitions/tags"
        },
        "documentationUrl": {
          "$ref": "./common-schema.json#/definitions/uri"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "apiVersion": "ai.agentbox.io/v1beta1",
      "kind": "Recipe",
      "metadata": {
        "name": "nightly-sft"
      },
      "spec": {
        "coreMetadata": {
          "description": "Nightly supervised fine-tuning pass",
          "type": "modelTraining",
          "version": "1.0.0",
          "status": "active"
        },
        "executionDefinition": {
          "stages": [
            {
              "id": "ingest",
              "name": "Load dataset",
              "type": "ingest"
            },
            {
              "id": "train",
              "name": "Fine-tune",
              "type": "train",
              "dependsOn": [
                "ingest"
              ]
            }
          ]
        }
      }
    }
  ]
}
