{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Escalations Schema",
  "description": "Validation schema for escalation rules, acknowledgment, repeat policy, and lifecycle",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "condition_expr": {
      "type": "object",
      "properties": {
        "metric_id": { "type": "string" },
        "$gt": { "type": "number" },
        "$gte": { "type": "number" },
        "$lt": { "type": "number" },
        "$lte": { "type": "number" },
        "$eq": { "type": ["number", "string", "boolean"] },
        "$neq": { "type": ["number", "string", "boolean"] }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "$and": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/condition_expr" }
        },
        "$or": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/condition_expr" }
        }
      },
      "additionalProperties": false
    },
    "acknowledgment": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "methods": {
          "type": "array",
          "items": { "enum": ["web_ui", "api", "sms_reply", "slack_button"] }
        },
        "auto_acknowledge_on_resolution": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "repeat_policy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "repeat_interval_minutes": { "type": "integer", "minimum": 1 },
        "max_repeats": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "lifecycle_step": {
      "type": "object",
      "properties": {
        "$eq": { "type": "string" },
        "after": { "type": "string" },
        "next": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "conditions", "notification_id"],
  "properties": {
    "id": { "$ref": "./common-schema.json#/definitions/id" },
    "conditions": { "$ref": "#/definitions/conditions" },
    "notification_id": { "type": "string" },
    "acknowledgment": { "$ref": "#/definitions/acknowledgment" },
    "repeat_policy": { "$ref": "#/definitions/repeat_policy" },
    "status": {
      "enum": [
        "acknowledged",
        "active",
        "under resolution",
        "resolved",
        "closed without resolution"
      ]
    },
    "lifecycle": {
      "type": "array",
      "items": { "$ref": "#/definitions/lifecycle_step" }
    },
    "tags": { "$ref": "./common-schema.json#/definitions/tags" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "escalation_rule_1",
      "conditions": {
        "$and": [
          { "metric_id": "metric_id_1", "$gt": 5000 },
          { "metric_id": "metric_id_2", "$lt": 100 }
        ]
      },
      "notification_id": "notification_1",
      "acknowledgment": {
        "required": true,
        "timeout_minutes": 30,
        "methods": ["web_ui", "api", "sms_reply", "slack_button"],
        "auto_acknowledge_on_resolution": true
      },
      "repeat_policy": {
        "enabled": false,
        "repeat_interval_minutes": 120,
        "max_repeats": 5
      },
      "status": "active",
      "lifecycle": [
        { "$eq": "acknowledged", "after": "30m", "next": "escalation_rule_2" }
      ]
    }
  ]
}

