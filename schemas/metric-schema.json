{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Metric Schema",
  "description": "Validation schema for metrics: base, metric_math, and ai-derived metrics",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "metric_type": {
      "enum": ["base", "metric_math", "ai"]
    },
    "category": {
      "enum": ["product", "engineering"]
    },
    "status": {
      "enum": ["active", "inactive", "test"]
    },
    "source_type": {
      "enum": ["logs_only"]
    },
    "unit": {
      "enum": ["Count", "Seconds", "Milliseconds", "Bytes", "Percent", "None"]
    },
    "statistic": {
      "enum": ["Sum", "Average", "Minimum", "Maximum", "SampleCount", "p50", "p90", "p95", "p99"]
    },
    "log_condition": {
      "type": "object",
      "required": ["path", "op"],
      "properties": {
        "path": { "type": "string" },
        "op": {
          "$ref": "./common-schema.json#/definitions/comparison_operator"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "log_query": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/log_condition" }
        },
        "severity_min": { "type": "integer", "minimum": 1, "maximum": 24, "default": 1 },
        "severity_max": { "type": "integer", "minimum": 1, "maximum": 24, "default": 24 },
        "time_range_seconds": { "type": "integer", "minimum": 1, "default": 60 }
      },
      "additionalProperties": false
    },
    "resource_selector": {
      "type": "object",
      "properties": {
        "attributes_match": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "op"],
            "properties": {
              "key": { "type": "string" },
              "op": { "$ref": "./common-schema.json#/definitions/comparison_operator" },
              "value": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "schema_url": { "type": "string" },
        "dropped_attributes_count_max": { "type": "integer", "minimum": 0 },
        "time_skew_tolerance_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "value_selector": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["count", "sum", "avg", "min", "max", "percentile", "extract", "ai"] },
        "path": { "type": "string" },
        "cast": { "enum": ["int", "float"] },
        "default": { "type": ["number", "string", "null"] },
        "percentile": { "type": "integer", "minimum": 0, "maximum": 100, "default": 95 },
        "transform": {
          "type": "object",
          "properties": {
            "regex": { "type": "string" },
            "jsonpath": { "type": "string" },
            "map": { "type": "object", "additionalProperties": {} }
          },
          "additionalProperties": false
        },
        "ai": {
          "type": "object",
          "properties": {
            "model_id": { "type": "string" },
            "gateway_id": { "type": "string" },
            "execution_mode": { "enum": ["inline", "background"] },
            "prompt_template": { "type": "string" },
            "input_binding": {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              },
              "additionalProperties": false
            },
            "output_parser": {
              "type": "object",
              "properties": {
                "regex": { "type": "string" },
                "cast": { "enum": ["float", "int", "string"] },
                "label_map": { "type": "object", "additionalProperties": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
            "cache_ttl_seconds": { "type": "integer", "minimum": 0, "default": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "from_logs": {
      "type": "object",
      "properties": {
        "resource_selector": { "$ref": "#/definitions/resource_selector" },
        "log_query": { "$ref": "#/definitions/log_query" },
        "validation": { "$ref": "#/definitions/validation" },
        "value_selector": { "$ref": "#/definitions/value_selector" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "optional": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "windowing": {
      "type": "object",
      "properties": {
        "lookback_seconds": { "type": "integer", "minimum": 1, "default": 300 },
        "sliding": { "type": "boolean", "default": true },
        "missing_data_policy": { "enum": ["ignore", "treat_as_zero", "break"], "default": "ignore" },
        "late_arrival_seconds": { "type": "integer", "minimum": 0, "default": 120 }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "type": "object",
      "properties": {
        "rollups_seconds": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "percentiles": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 99 } }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "raw_minutes": { "type": "integer", "minimum": 1 },
        "rollups_days": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "prometheus_name": { "type": "string" },
        "cloudwatch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "namespace": { "type": "string" },
            "storage_resolution_seconds": { "type": "integer", "minimum": 1, "default": 60 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allowed_writers": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "metric_math_block": {
      "type": "object",
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string" },
        "input_metrics": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "nan_handling": { "enum": ["treat_as_zero", "propagate", "skip"] },
        "output_unit": { "enum": ["Percent", "Count", "Seconds"] }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "type", "metric_name"],
  "properties": {
    "id": { "$ref": "./common-schema.json#/definitions/id" },
    "type": { "$ref": "#/definitions/metric_type" },
    "namespace": { "type": "string" },
    "metric_name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "$ref": "#/definitions/category" },
    "status": { "$ref": "#/definitions/status" },
    "calculated": { "type": "boolean", "default": true },
    "source_type": { "$ref": "#/definitions/source_type" },
    "from_logs": { "$ref": "#/definitions/from_logs" },
    "metric_math": { "$ref": "#/definitions/metric_math_block" },
    "dimensions": { "$ref": "#/definitions/dimensions" },
    "unit": { "$ref": "#/definitions/unit" },
    "statistic": { "$ref": "#/definitions/statistic" },
    "period_seconds": { "type": "integer", "minimum": 1, "default": 60 },
    "storage_resolution_seconds": { "type": "integer", "minimum": 1, "default": 1 },
    "windowing": { "$ref": "#/definitions/windowing" },
    "aggregation": { "$ref": "#/definitions/aggregation" },
    "retention": { "$ref": "#/definitions/retention" },
    "export": { "$ref": "#/definitions/export" },
    "permissions": { "$ref": "#/definitions/permissions" },
    "tags": { "$ref": "./common-schema.json#/definitions/tags" },
    "enforcement": {
      "type": "object",
      "properties": {
        "require_log_source": { "type": "boolean" },
        "drop_if_no_valid_logs": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "base" } }, "required": ["type"] },
      "then": {
        "required": ["from_logs", "unit", "statistic", "period_seconds"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "metric_math" } }, "required": ["type"] },
      "then": {
        "required": ["metric_math", "unit", "statistic", "period_seconds"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "ai" } }, "required": ["type"] },
      "then": {
        "required": ["from_logs", "unit", "statistic", "period_seconds"],
        "properties": {
          "from_logs": {
            "required": ["value_selector"],
            "properties": {
              "value_selector": {
                "required": ["type", "ai"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "examples": [
    {
      "id": "metric_latency_ms",
      "type": "base",
      "namespace": "agentbox.api",
      "metric_name": "request_latency",
      "description": "API request latency",
      "category": "engineering",
      "status": "active",
      "source_type": "logs_only",
      "from_logs": {
        "log_query": {
          "pattern": "request completed",
          "conditions": [
            { "path": "severity", "op": "gte", "value": 9 }
          ],
          "severity_min": 1,
          "severity_max": 24,
          "time_range_seconds": 60
        },
        "value_selector": {
          "type": "extract",
          "path": "attributes.duration_ms",
          "cast": "float",
          "default": 0
        }
      },
      "unit": "Milliseconds",
      "statistic": "Average",
      "period_seconds": 60,
      "storage_resolution_seconds": 1
    },
    {
      "id": "metric_error_rate",
      "type": "metric_math",
      "namespace": "agentbox.api",
      "metric_name": "error_rate",
      "description": "Error rate percentage",
      "category": "engineering",
      "status": "active",
      "metric_math": {
        "expression": "(a / (a + b)) * 100",
        "input_metrics": { "a": "metric_errors", "b": "metric_success" },
        "variables": { "k": 1 },
        "nan_handling": "treat_as_zero",
        "output_unit": "Percent"
      },
      "unit": "Percent",
      "statistic": "Average",
      "period_seconds": 60
    },
    {
      "id": "metric_ai_sentiment",
      "type": "ai",
      "namespace": "agentbox.chat",
      "metric_name": "user_sentiment",
      "description": "Average user sentiment extracted by LLM",
      "category": "product",
      "status": "active",
      "from_logs": {
        "log_query": {
          "conditions": [
            { "path": "attributes.event", "op": "eq", "value": "user_message" }
          ]
        },
        "validation": {
          "required_fields": ["attributes.message_text"]
        },
        "value_selector": {
          "type": "ai",
          "ai": {
            "model_id": "llama-3-70b-instruct",
            "gateway_id": "llama-3-70b-instruct",
            "execution_mode": "inline",
            "prompt_template": "Score the sentiment from -1 to 1 for: {{text}}",
            "input_binding": { "text": "attributes.message_text" },
            "output_parser": { "cast": "float" },
            "confidence_threshold": 0.0,
            "cache_ttl_seconds": 0
          }
        }
      },
      "unit": "None",
      "statistic": "Average",
      "period_seconds": 60,
      "storage_resolution_seconds": 1
    }
  ]
}

