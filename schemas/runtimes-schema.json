{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Runtimes Schema",
  "description": "Validation schema for runtime specifications, IO bindings, endpoints, and observability",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "runtime_kind": { "enum": ["server", "worker", "batch", "cron"] },
    "metadata": {
      "type": "object",
      "required": ["runtime_id", "version", "kind"],
      "properties": {
        "runtime_id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "kind": { "$ref": "#/definitions/runtime_kind" },
        "governed_by": { "type": "string" },
        "tags": { "$ref": "./common-schema.json#/definitions/tags" }
      },
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "object",
          "properties": {
            "cores": { "type": "integer", "minimum": 0 },
            "threads": { "type": "integer", "minimum": 0 },
            "memory_mb": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string" },
            "count": { "type": "integer", "minimum": 0 },
            "memory_mb": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "persist": { "type": "boolean", "default": true },
            "size_in_gb": { "type": "integer", "minimum": 0 },
            "iops": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "entrypoint": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "repo": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "ref": { "type": "string" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "store": { "type": "string" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routing_filter": {
      "type": "object",
      "properties": {
        "type": { "enum": ["path"] },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "properties": {
        "type": { "enum": ["jq"] },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "io_binding": {
      "type": "object",
      "required": ["connector_id", "routing"],
      "properties": {
        "connector_id": { "type": "string" },
        "governance_id": { "type": "string" },
        "routing": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "filters": { "type": "array", "items": { "$ref": "#/definitions/routing_filter" } },
            "transformations": { "type": "array", "items": { "$ref": "#/definitions/transformation" } }
          },
          "additionalProperties": false
        },
        "concurrency": {
          "type": "object",
          "properties": {
            "max_concurrent": { "type": "integer", "minimum": 1 },
            "max_queue_size": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "rate_limiting": {
          "type": "object",
          "properties": {
            "requests_per_second": { "type": "integer", "minimum": 0 },
            "burst_size": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "config": { "type": "object" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "endpoint_id": { "type": "string" },
        "interface": { "enum": ["http", "grpc", "websocket"] },
        "path": { "type": "string" },
        "request": {
          "type": "object",
          "properties": {
            "body_template": { "type": "object" },
            "headers": { "type": "object" },
            "query": { "type": "object" }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "type": { "enum": ["json", "text", "binary", "stream"] },
            "schema": { "type": "object" }
          },
          "additionalProperties": false
        },
        "policy_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "level": { "enum": ["debug", "info", "warning", "error"] }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "traces": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "sample_rate": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "otel_exporter": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "protocol": { "enum": ["grpc", "http", "protobuf"] },
            "headers": { "type": "object" },
            "resource_attributes": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "type": { "enum": ["http", "grpc"] },
        "path": { "type": "string" },
        "service": { "type": "string" },
        "method": { "type": "string" },
        "metric_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "type": { "enum": ["manual", "cron", "interval"] },
        "cron_expression": { "type": "string" },
        "timezone": { "type": "string", "default": "UTC" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "compute": { "$ref": "#/definitions/compute" },
        "code": { "$ref": "#/definitions/code" },
        "io_bindings": { "type": "array", "items": { "$ref": "#/definitions/io_binding" } },
        "endpoints": { "type": "array", "items": { "$ref": "#/definitions/endpoint" } },
        "schedule": { "$ref": "#/definitions/schedule" },
        "policy_ids": { "type": "array", "items": { "type": "string" } },
        "observability": { "$ref": "#/definitions/observability" },
        "health": { "$ref": "#/definitions/health" },
        "rules": { "type": "array", "items": { "type": "object" } },
        "routing": { "type": "object" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "state": { "enum": ["active", "inactive"] },
        "conditions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  },
  "required": ["metadata", "spec"],
  "properties": {
    "metadata": { "$ref": "#/definitions/metadata" },
    "spec": { "$ref": "#/definitions/spec" },
    "status": { "$ref": "#/definitions/status" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "metadata": {
        "runtime_id": "rt_api_1",
        "name": "api-runtime",
        "version": "1.0.0",
        "kind": "server",
        "governed_by": "gov_id_1"
      },
      "spec": {
        "compute": {
          "cpu": { "cores": 4, "threads": 8, "memory_mb": 8192 },
          "gpu": { "enabled": false, "type": "", "count": 0, "memory_mb": 0 },
          "storage": { "persist": true, "size_in_gb": 100, "iops": 1000 }
        },
        "io_bindings": [
          {
            "connector_id": "kafka_stream",
            "routing": {
              "from": "kafka_stream",
              "to": "endpoint:process_event",
              "filters": [{ "type": "path", "expression": "$.event_type == 'order.created'" }],
              "transformations": [{ "type": "jq", "expression": ".payload | {orderId: .id}" }]
            },
            "concurrency": { "max_concurrent": 10, "max_queue_size": 1000 },
            "rate_limiting": { "requests_per_second": 100, "burst_size": 20 }
          }
        ],
        "endpoints": [
          {
            "endpoint_id": "process_event",
            "interface": "http",
            "path": "/process",
            "response": { "type": "json", "schema": {} },
            "policy_ids": ["policy_id_1"]
          }
        ],
        "schedule": { "type": "manual", "timezone": "UTC" },
        "policy_ids": ["policy_id_1"],
        "observability": {
          "logs": { "enabled": true, "level": "info" },
          "metrics": { "enabled": true },
          "traces": { "enabled": true, "sample_rate": 0.1 }
        },
        "health": { "type": "http", "path": "/health", "metric_ids": ["metric_id_1"] }
      },
      "status": { "state": "active", "conditions": [] }
    }
  ]
}

