{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Agents Schema",
  "description": "Validation schema for agent graphs, prompts, tools, and execution hooks",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "min_max": {
      "type": "object",
      "properties": {
        "$min": { "type": "number" },
        "$max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "usage_limits": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/min_max" }
    },
    "call_type": { "enum": ["tool_call", "agent"] },
    "hook": {
      "type": "object",
      "properties": {
        "call_type": { "$ref": "#/definitions/call_type" },
        "input_parser": {
          "type": "object",
          "properties": {
            "gateway_id": { "type": "string" },
            "model_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "output_formatter": {
          "type": "object",
          "properties": {
            "gateway_id": { "type": "string" },
            "model_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "tool_id": { "type": "string" },
        "agent_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "prompt_variable": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["string", "number", "boolean", "timestamp", "object"] },
        "source": { "enum": ["metric", "node_spec", "calculated"] },
        "path": { "type": "string" },
        "default_value": {},
        "format": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "prompts": {
      "type": "object",
      "properties": {
        "template": {
          "type": "object",
          "properties": {
            "system": { "type": "string" },
            "user": { "type": "string" }
          },
          "additionalProperties": false
        },
        "variables": {
          "type": "object",
          "properties": {
            "system": { "type": "array", "items": { "$ref": "#/definitions/prompt_variable" } },
            "user": { "type": "array", "items": { "$ref": "#/definitions/prompt_variable" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "graph_node": {
      "type": "object",
      "properties": {
        "model_id": { "type": "string" },
        "gateway_id": { "type": "string" },
        "pre_execution": { "$ref": "#/definitions/hook" },
        "post_execution": { "$ref": "#/definitions/hook" },
        "tool_ids": { "type": "array", "items": { "type": "string" } },
        "prompts": { "$ref": "#/definitions/prompts" }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/graph_node" }
    }
  },
  "required": ["name", "start_node", "graph"],
  "properties": {
    "name": { "type": "string" },
    "usage_limits": { "$ref": "#/definitions/usage_limits" },
    "start_node": { "type": "string" },
    "governance_controls": { "type": "string" },
    "graph": { "$ref": "#/definitions/graph" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "orchestrator",
      "usage_limits": { "metric_id": { "$min": 100, "$max": 500 } },
      "start_node": "state_id_1",
      "governance_controls": "gov_id_1",
      "graph": {
        "state_id_1": {
          "model_id": "model_id_1",
          "gateway_id": "gateway_id_1",
          "pre_execution": { "call_type": "tool_call", "tool_id": "tool_id_1" },
          "post_execution": { "call_type": "tool_call", "tool_id": "tool_id_2" },
          "tool_ids": ["tool_id_1", "tool_id_2"],
          "prompts": {
            "template": { "system": "You are helpful.", "user": "Do X" },
            "variables": {
              "system": [{ "name": "env", "type": "string", "required": true }],
              "user": [{ "name": "query", "type": "string", "required": true }]
            }
          }
        }
      }
    }
  ]
}

