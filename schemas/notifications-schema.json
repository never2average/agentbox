{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Notifications Schema",
  "description": "Validation schema for notification templates, recipients, delivery and variables",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "variable": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": {
          "$ref": "./common-schema.json#/definitions/non_empty_string"
        },
        "type": {
          "enum": ["string", "number", "boolean", "timestamp", "object"]
        },
        "source": {
          "enum": ["metric", "node_spec", "calculated"]
        },
        "path": {
          "type": "string"
        },
        "default_value": {
          "type": ["string", "number", "boolean", "object", "null"]
        },
        "format": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["default_channel_id", "fallback_channel_ids"],
      "properties": {
        "default_channel_id": {
          "$ref": "./common-schema.json#/definitions/non_empty_string"
        },
        "fallback_channel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "recipients", "template_string", "delivery"],
  "properties": {
    "id": {
      "$ref": "./common-schema.json#/definitions/id"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Recipient identifiers (emails, phone numbers, user IDs, or channel aliases)"
    },
    "template_string": {
      "type": "string",
      "minLength": 1,
      "description": "Notification template with placeholders like {{variable_name}}"
    },
    "delivery": {
      "$ref": "#/definitions/delivery"
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/variable"
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "notification_order_created",
      "recipients": ["ops-team", "oncall_user_1"],
      "template_string": "Order {{order_id}} created by {{customer_id}}",
      "delivery": {
        "default_channel_id": "slack_ops",
        "fallback_channel_ids": ["pagerduty_oncall"]
      },
      "variables": [
        {
          "name": "order_id",
          "type": "string",
          "source": "metric",
          "path": "attributes.order.id",
          "required": true
        },
        {
          "name": "customer_id",
          "type": "string",
          "source": "metric",
          "path": "attributes.order.customer_id",
          "required": false
        }
      ]
    }
  ]
}

