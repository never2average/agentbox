{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Logs Schema",
  "description": "Validation schema for OpenTelemetry-style log export batches used within AgentBox",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "typed_value": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "array", "object", "bytes"]
        },
        "string_value": { "type": "string" },
        "bool_value": { "type": "boolean" },
        "int_value": { "type": "integer" },
        "double_value": { "type": "number" },
        "bytes_value": { "type": "string" },
        "array_value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/typed_value"
          }
        },
        "kvlist_value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attribute"
          }
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "$ref": "#/definitions/typed_value" }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/attribute" }
        },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/attribute" }
        },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "log_record": {
      "type": "object",
      "required": ["time_unix_nano", "severity_number", "severity_text", "body"],
      "properties": {
        "time_unix_nano": { "type": "integer", "minimum": 0 },
        "observed_time_unix_nano": { "type": "integer", "minimum": 0 },
        "severity_number": { "type": "integer", "minimum": 1, "maximum": 24 },
        "severity_text": { "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"] },
        "body": { "$ref": "#/definitions/typed_value" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/attribute" }
        },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 },
        "flags": { "type": "integer", "minimum": 0 },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$",
          "description": "Hex-encoded 16-byte trace ID"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{16}$",
          "description": "Hex-encoded 8-byte span ID"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["resource", "log_records"],
  "properties": {
    "resource": { "$ref": "#/definitions/resource" },
    "resource_schema_url": { "type": "string" },
    "scope": { "$ref": "#/definitions/scope" },
    "scope_schema_url": { "type": "string" },
    "log_records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/log_record" }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "resource": {
        "attributes": [
          { "key": "service.name", "value": { "type": "string", "string_value": "agentbox-api" } }
        ],
        "dropped_attributes_count": 0
      },
      "scope": {
        "name": "agentbox.logs",
        "version": "1.0.0",
        "attributes": []
      },
      "log_records": [
        {
          "time_unix_nano": 1718123456789000000,
          "observed_time_unix_nano": 1718123456790000000,
          "severity_number": 9,
          "severity_text": "INFO",
          "body": { "type": "string", "string_value": "Processed 42 events" },
          "attributes": [
            { "key": "request.id", "value": { "type": "string", "string_value": "abc123" } }
          ],
          "flags": 0
        }
      ]
    }
  ]
}

