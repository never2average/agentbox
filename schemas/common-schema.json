{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentbox.io/schemas/common-schema.json",
  "title": "AgentBox Common Schema Definitions",
  "description": "Shared JSON Schema definitions reused across the AgentBox CRDs",
  "version": "2.0.0",
  "type": "object",
  "definitions": {
    "apiVersion": {
      "const": "ai.agentbox.io/v1beta1",
      "description": "API group/version shared by every AgentBox CRD"
    },
    "dnsName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 253,
      "description": "RFC 1123 name, as used by metadata.name"
    },
    "objectMeta": {
      "type": "object",
      "description": "Standard Kubernetes object metadata. Anything descriptive that is not name, namespace, labels or annotations belongs in spec.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/dnsName"
        },
        "namespace": {
          "$ref": "#/definitions/dnsName"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "type",
        "status"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "status": {
          "enum": [
            "True",
            "False",
            "Unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "lastTransitionTime": {
          "$ref": "#/definitions/isoDatetime"
        }
      },
      "additionalProperties": false
    },
    "resourceStatus": {
      "type": "object",
      "description": "Standard status subresource shared by every AgentBox CRD",
      "properties": {
        "state": {
          "enum": [
            "pending",
            "active",
            "degraded",
            "suspended",
            "completed",
            "failed",
            "inactive",
            "unknown"
          ]
        },
        "message": {
          "type": "string"
        },
        "observedGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "lastTransitionTime": {
          "$ref": "#/definitions/isoDatetime"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "description": "Total replicas observed. Read by the scale subresource."
        },
        "readyReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "selector": {
          "type": "string",
          "description": "Label selector in string form. Read by the scale subresource."
        }
      },
      "additionalProperties": true
    },
    "replicaBounds": {
      "type": "object",
      "description": "Replica bounds shared by every AutoScaler CRD",
      "required": [
        "maxReplicas"
      ],
      "properties": {
        "minReplicas": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "scalingMetric": {
      "type": "object",
      "description": "A single scaling signal, sourced from an AIMetric or a raw resource metric",
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "aiMetric",
            "resource",
            "external"
          ]
        },
        "metric": {
          "$ref": "common-schema.json#/definitions/dnsName",
          "description": "Name of the AIMetric supplying this signal."
        },
        "resource": {
          "enum": [
            "cpu",
            "memory",
            "gpu",
            "gpuMemory"
          ]
        },
        "name": {
          "type": "string"
        },
        "selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "target": {
          "type": "object",
          "required": [
            "metricType",
            "value"
          ],
          "properties": {
            "metricType": {
              "enum": [
                "utilization",
                "averageValue",
                "value"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "aiMetric"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "metric"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "resource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "external"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "name"
            ]
          }
        }
      ]
    },
    "scalingBehavior": {
      "type": "object",
      "description": "Stabilization and rate limits applied to scale up/down decisions",
      "properties": {
        "scaleUp": {
          "$ref": "#/definitions/scalingRules"
        },
        "scaleDown": {
          "$ref": "#/definitions/scalingRules"
        },
        "scaleToZero": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "idleSeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scalingRules": {
      "type": "object",
      "properties": {
        "stabilizationWindowSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 300,
          "maximum": 3600
        },
        "selectPolicy": {
          "enum": [
            "max",
            "min",
            "disabled"
          ],
          "default": "max"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value",
              "periodSeconds"
            ],
            "properties": {
              "type": {
                "enum": [
                  "pods",
                  "percent"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "periodSeconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "computeResources": {
      "type": "object",
      "description": "Compute request shared by workload-backed CRDs",
      "properties": {
        "cpu": {
          "type": "object",
          "properties": {
            "cores": {
              "type": "number",
              "minimum": 0,
              "maximum": 1024
            },
            "threads": {
              "type": "integer",
              "minimum": 0
            },
            "memoryMb": {
              "type": "integer",
              "minimum": 16
            }
          },
          "additionalProperties": false
        },
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "memoryMb": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "type": "object",
          "properties": {
            "persist": {
              "type": "boolean",
              "default": false
            },
            "sizeInGb": {
              "type": "integer",
              "minimum": 0
            },
            "iops": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "isoDatetime": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret://"
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        },
        "backoffMultiplier": {
          "type": "number",
          "minimum": 1,
          "default": 2
        },
        "retryOnStatusCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            500,
            502,
            503,
            504,
            429
          ]
        }
      },
      "additionalProperties": false
    },
    "authType": {
      "enum": [
        "none",
        "bearer",
        "basic",
        "apiKey",
        "oauth2",
        "jwt",
        "hmac",
        "iamRole",
        "serviceAccount",
        "mutualTls",
        "sasl"
      ]
    },
    "httpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "storageBackend": {
      "enum": [
        "memory",
        "persistent",
        "kafka",
        "dynamodb",
        "sqlite",
        "postgres",
        "mysql",
        "redis",
        "etcd",
        "firestore",
        "mongodb",
        "cassandra",
        "none"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/definitions/tags"
        },
        "owner": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/definitions/isoDatetime"
        },
        "updatedAt": {
          "$ref": "#/definitions/isoDatetime"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "comparisonOperator": {
      "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "neq",
        "in",
        "notIn",
        "matches",
        "exists"
      ]
    },
    "scaleTargetRef": {
      "type": "object",
      "description": "Reference to the resource an AutoScaler owns",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/definitions/apiVersion"
        },
        "kind": {
          "enum": [
            "Model",
            "ModelAutoScaler",
            "HarnessRuntime",
            "HarnessSwarmAutoScaler",
            "AgentIdP",
            "ToolServer",
            "ToolServerAutoScaler",
            "Gateway",
            "AIMetric",
            "AIMeter",
            "TrainLoop",
            "Dataset",
            "Evaluator",
            "Guardrail",
            "Tracer",
            "Recipe"
          ]
        },
        "name": {
          "$ref": "#/definitions/dnsName"
        },
        "namespace": {
          "$ref": "#/definitions/dnsName"
        }
      },
      "additionalProperties": false
    },
    "secretKeyRef": {
      "type": "object",
      "description": "A key inside a Secret in the same namespace. Credentials belong here, never inline in a spec that lands in git and etcd.",
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/dnsName",
          "description": "Secret name."
        },
        "key": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]+$",
          "description": "Key within the Secret."
        }
      },
      "additionalProperties": false
    },
    "secretEnv": {
      "type": "object",
      "description": "Environment variables sourced from Secrets. The key is the variable name; the value says which Secret key supplies it.",
      "additionalProperties": {
        "$ref": "#/definitions/secretKeyRef"
      }
    }
  }
}
