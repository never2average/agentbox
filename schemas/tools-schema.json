{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Tools Schema",
  "description": "Validation schema for tool definitions including parameters, returns, execution, state, permissions, and monitoring",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "tool_type": { "enum": ["stateless", "stateful"] },
    "json_schema": { "type": "object" },
    "parameters": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" },
        "required": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "returns": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "string", "number", "boolean", "array"] },
        "description": { "type": "string" },
        "schema": { "$ref": "#/definitions/json_schema" }
      },
      "additionalProperties": false
    },
    "execution_type": { "enum": ["runtime", "agent"] },
    "http_method": { "$ref": "./common-schema.json#/definitions/http_method" },
    "request_format": {
      "type": "object",
      "properties": {
        "body_template": { "type": "object" },
        "headers": { "type": "object" },
        "query_params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "response_format": {
      "type": "object",
      "properties": {
        "type": { "enum": ["json", "text", "binary", "stream"] },
        "schema": { "type": "object" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["type", "timeout_seconds"],
      "properties": {
        "type": { "$ref": "#/definitions/execution_type" },
        "runtime": {
          "type": "object",
          "properties": {
            "runtime_id": { "type": "string" },
            "endpoint_id": { "type": "string" },
            "method": { "enum": ["http", "grpc", "websocket"] },
            "request_format": { "$ref": "#/definitions/request_format" },
            "response_format": { "$ref": "#/definitions/response_format" }
          },
          "additionalProperties": false
        },
        "agent": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "execution_mode": { "enum": ["inline", "background"] },
            "pass_context": { "type": "boolean", "default": true },
            "context_filter": { "type": "string" },
            "result_handling": { "enum": ["return", "merge", "accumulate"] }
          },
          "additionalProperties": false
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "default": 30 },
        "retry_policy": { "$ref": "./common-schema.json#/definitions/retry_policy" },
        "async_execution": { "type": "boolean", "default": false },
        "batch_supported": { "type": "boolean", "default": false },
        "max_batch_size": { "type": "integer", "minimum": 1, "default": 10 }
      },
      "additionalProperties": false
    },
    "state_management": {
      "type": "object",
      "properties": {
        "persistent_state": { "type": "boolean", "default": false },
        "state_storage": { "enum": ["memory", "redis", "database"] },
        "state_key": { "type": "string" },
        "state_ttl_seconds": { "type": "integer", "minimum": 0, "default": 3600 },
        "shared_across_sessions": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "required_scopes": { "type": "array", "items": { "type": "string" } },
        "allowed_roles": { "type": "array", "items": { "type": "string" } },
        "requires_approval": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "log_execution": { "type": "boolean", "default": true },
        "log_level": { "enum": ["debug", "info", "warning", "error"] },
        "track_metrics": { "type": "boolean", "default": true },
        "alert_on_failure": { "type": "boolean", "default": false },
        "notification_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "required": ["tool_id", "name", "type", "enabled", "version", "parameters", "returns", "execution"],
  "properties": {
    "tool_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "type": { "$ref": "#/definitions/tool_type" },
    "enabled": { "type": "boolean", "default": true },
    "version": { "type": "string" },
    "parameters": { "$ref": "#/definitions/parameters" },
    "returns": { "$ref": "#/definitions/returns" },
    "execution": { "$ref": "#/definitions/execution" },
    "state_management": { "$ref": "#/definitions/state_management" },
    "permissions": { "$ref": "#/definitions/permissions" },
    "monitoring": { "$ref": "#/definitions/monitoring" },
    "examples": { "type": "array", "items": { "$ref": "#/definitions/example" } }
  },
  "additionalProperties": false,
  "examples": [
    {
      "tool_id": "summarize_text",
      "name": "Summarize Text",
      "description": "Summarize input text into a short abstract",
      "type": "stateless",
      "enabled": true,
      "version": "1.0.0",
      "parameters": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Text to summarize" },
          "max_sentences": { "type": "integer", "minimum": 1, "default": 3 }
        },
        "required": ["text"]
      },
      "returns": {
        "type": "object",
        "description": "Summarization result",
        "schema": {
          "type": "object",
          "properties": {
            "result": { "type": "string" },
            "status": { "type": "string", "enum": ["success", "error", "pending"] }
          },
          "required": ["result", "status"],
          "additionalProperties": false
        }
      },
      "execution": {
        "type": "agent",
        "agent": {
          "agent_id": "agent_summarizer",
          "execution_mode": "inline",
          "pass_context": true,
          "result_handling": "return"
        },
        "timeout_seconds": 30,
        "retry_policy": { "max_retries": 3, "retry_delay_seconds": 1, "backoff_multiplier": 2, "retry_on_status_codes": [500, 502, 503, 504, 429] },
        "async_execution": false,
        "batch_supported": false,
        "max_batch_size": 10
      }
    }
  ]
}

