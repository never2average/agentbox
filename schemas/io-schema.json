{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox IO Connector Schema",
  "description": "Comprehensive schema for IO connector types in AgentBox",
  "version": "1.0.0",  
  "definitions": {
    "connector_types": {
      "enum": [
        "http_poll",
        "webhook",
        "kafka",
        "queue",
        "s3",
        "fs",
        "database",
        "grpc",
        "pubsub",
        "mqtt",
        "rabbitmq",
        "redis_stream",
        "websocket",
        "ftp",
        "sftp",
        "nats",
        "kinesis",
        "eventbridge"
      ],
      "description": "All supported IO connector types"
    },
    
    "direction": {
      "enum": ["source", "sink", "both"],
      "description": "Data flow direction - source (inbound), sink (outbound), or both (bidirectional)"
    },
    
    "state_management_type": {
      "enum": [
        "cursor",
        "offset",
        "watermark",
        "receipt_handle",
        "file_tracker",
        "ack_id",
        "stream_position",
        "checkpoint",
        "none"
      ],
      "description": "Type of state management strategy for the connector"
    },
    
    "storage_backend": {
      "enum": [
        "memory",
        "persistent",
        "kafka",
        "dynamodb",
        "sqlite",
        "postgres",
        "mysql",
        "redis",
        "etcd",
        "firestore",
        "mongodb",
        "cassandra",
        "none"
      ],
      "description": "Backend storage system for state persistence"
    },
    
    "auth_type": {
      "enum": [
        "none",
        "bearer",
        "basic",
        "api_key",
        "oauth2",
        "jwt",
        "hmac",
        "iam_role",
        "service_account",
        "mutual_tls",
        "sasl"
      ],
      "description": "Authentication mechanism types"
    },
    
    "http_method": {
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
      "description": "HTTP request methods"
    },
    
    "checkpoint_strategy": {
      "enum": [
        "incremental",
        "full",
        "commit_sync",
        "commit_async",
        "transactional",
        "delete_on_success",
        "mark_processed",
        "ack_on_success",
        "ack_based",
        "none"
      ],
      "description": "Strategy for checkpointing processed data"
    },
    
    "base_config": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the connector is enabled"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 30,
          "description": "Request/operation timeout in seconds"
        },
        "retry_policy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 3
            },
            "retry_delay_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            },
            "backoff_multiplier": {
              "type": "number",
              "minimum": 1,
              "default": 2
            },
            "retry_on_status_codes": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "default": [500, 502, 503, 504, 429]
            }
          }
        }
      }
    },
    
    "auth_config": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "#/definitions/auth_type"
        },
        "bearer_token": {
          "type": "string",
          "description": "Bearer token (use secret:// ref in production)"
        },
        "api_key": {
          "type": "string",
          "description": "API key (use secret:// ref in production)"
        },
        "api_key_header": {
          "type": "string",
          "default": "X-API-Key"
        },
        "username": {
          "type": "string"
        },
        "password_ref": {
          "type": "string",
          "pattern": "^secret://",
          "description": "Reference to secret storage"
        },
        "credentials_ref": {
          "type": "string",
          "pattern": "^secret://",
          "description": "Reference to credential file or secret"
        },
        "secret_ref": {
          "type": "string",
          "pattern": "^secret://"
        },
        "role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::"
        },
        "oauth2": {
          "type": "object",
          "properties": {
            "client_id": {"type": "string"},
            "client_secret_ref": {"type": "string", "pattern": "^secret://"},
            "token_url": {"type": "string", "format": "uri"},
            "scopes": {"type": "array", "items": {"type": "string"}},
            "grant_type": {"enum": ["client_credentials", "authorization_code", "refresh_token"]}
          }
        }
      }
    },
    
    "state_management": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable state management for fault tolerance"
        },
        "type": {
          "$ref": "#/definitions/state_management_type"
        },
        "storage": {
          "type": "object",
          "required": ["backend"],
          "properties": {
            "backend": {
              "$ref": "#/definitions/storage_backend"
            },
            "location": {
              "type": "string",
              "description": "Storage location (path, table name, key prefix, etc.)"
            },
            "encryption": {
              "type": "boolean",
              "default": false,
              "description": "Enable encryption at rest"
            },
            "connection": {
              "type": "object",
              "description": "Connection details for storage backend"
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Checkpoint interval in seconds"
            },
            "on_batch_complete": {
              "type": "boolean",
              "default": true,
              "description": "Checkpoint after each batch completes"
            },
            "strategy": {
              "$ref": "#/definitions/checkpoint_strategy"
            }
          }
        },
        "cursor": {
          "type": "object",
          "description": "Cursor-based state tracking (for http_poll, database)",
          "properties": {
            "field": {
              "type": "string",
              "description": "Field name to track (e.g., 'last_modified', 'id')"
            },
            "initial_value": {
              "type": ["string", "number", "null"],
              "description": "Starting cursor value"
            },
            "format": {
              "enum": ["iso8601", "unix_timestamp", "integer", "string"],
              "description": "Cursor value format"
            }
          }
        },
        "offset": {
          "type": "object",
          "description": "Offset-based state tracking (for Kafka, Kinesis)",
          "properties": {
            "commit_mode": {
              "enum": ["auto", "manual", "sync", "async"],
              "default": "manual"
            },
            "auto_commit_interval_ms": {
              "type": "integer",
              "default": 5000
            },
            "reset_policy": {
              "enum": ["earliest", "latest", "none"],
              "default": "latest"
            }
          }
        },
        "watermark": {
          "type": "object",
          "description": "Watermark-based state tracking (for databases)",
          "properties": {
            "column": {
              "type": "string",
              "description": "Column to track (e.g., 'id', 'updated_at')"
            },
            "type": {
              "enum": ["incremental", "timestamp", "composite"],
              "default": "incremental"
            },
            "initial_value": {
              "type": ["string", "number", "null"]
            },
            "fallback_column": {
              "type": "string",
              "description": "Fallback column if primary is null"
            }
          }
        },
        "visibility": {
          "type": "object",
          "description": "Visibility timeout management (for queue systems)",
          "properties": {
            "tracking_enabled": {
              "type": "boolean",
              "default": true
            },
            "extend_on_processing": {
              "type": "boolean",
              "default": true
            },
            "extension_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            }
          }
        },
        "file_tracking": {
          "type": "object",
          "description": "File tracking for filesystem/S3 connectors",
          "properties": {
            "track_by": {
              "enum": ["etag", "inode_mtime", "hash", "path_mtime"],
              "description": "What to use for tracking file changes"
            },
            "store_metadata": {
              "type": "boolean",
              "default": true
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Metadata fields to store"
            }
          }
        },
        "ack_management": {
          "type": "object",
          "description": "Acknowledgment management (for Pub/Sub)",
          "properties": {
            "deadline_extension_enabled": {
              "type": "boolean",
              "default": true
            },
            "extension_interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "max_extension_count": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            }
          }
        },
        "stream_position": {
          "type": "object",
          "description": "Stream position tracking (for gRPC, WebSocket)",
          "properties": {
            "token_type": {
              "enum": ["opaque", "sequence", "timestamp"],
              "description": "Type of position token"
            },
            "resume_enabled": {
              "type": "boolean",
              "default": true
            },
            "buffer_size": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            }
          }
        },
        "deduplication": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable deduplication of messages/records"
            },
            "key_fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Fields to use for deduplication key"
            },
            "window_seconds": {
              "type": "integer",
              "minimum": 60,
              "description": "Deduplication window duration"
            },
            "storage": {
              "$ref": "#/definitions/storage_backend"
            }
          }
        },
        "exactly_once": {
          "type": "object",
          "description": "Exactly-once delivery semantics",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "enum": [
                "idempotency_key",
                "transactional_outbox",
                "two_phase_commit",
                "pubsub_exactly_once_delivery",
                "kafka_transactions"
              ]
            },
            "isolation_level": {
              "enum": ["read_uncommitted", "read_committed"],
              "description": "For Kafka transactions"
            },
            "transactional_id": {
              "type": "string",
              "description": "For Kafka transactions"
            },
            "idempotency_table": {
              "type": "string",
              "description": "Table for idempotency tracking"
            },
            "outbox_table": {
              "type": "string",
              "description": "Table for transactional outbox pattern"
            },
            "ttl_seconds": {
              "type": "integer",
              "minimum": 60
            },
            "header_name": {
              "type": "string",
              "description": "Header name for idempotency key"
            },
            "polling_interval_ms": {
              "type": "integer",
              "minimum": 10
            },
            "enable_ordering": {
              "type": "boolean"
            }
          }
        },
        "resume": {
          "type": "object",
          "description": "Resume capability for large file transfers",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "chunk_size_bytes": {
              "type": "integer",
              "minimum": 1024
            },
            "multipart_threshold_bytes": {
              "type": "integer",
              "minimum": 1048576
            },
            "checkpoint_interval_bytes": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "change_data_capture": {
          "type": "object",
          "description": "CDC configuration for databases",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "enum": ["logical_replication", "trigger_based", "log_based", "query_based"]
            },
            "slot_name": {
              "type": "string"
            },
            "publication": {
              "type": "string"
            }
          }
        },
        "dead_letter": {
          "type": "object",
          "description": "Dead letter queue/topic configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "max_delivery_attempts": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "dlq_url": {
              "type": "string",
              "description": "Dead letter queue URL (for SQS)"
            },
            "dlq_topic": {
              "type": "string",
              "description": "Dead letter topic (for Pub/Sub, Kafka)"
            }
          }
        }
      }
    },
    
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string"
        }
      }
    },
    
    "http_poll_config": {
      "type": "object",
      "required": ["url", "method", "interval_seconds"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "$ref": "#/definitions/http_method"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query_params": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "body": {
          "type": ["object", "string", "null"]
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Polling interval in seconds"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "auth": {
          "$ref": "#/definitions/auth_config"
        },
        "response_format": {
          "enum": ["json", "xml", "csv", "text", "binary"],
          "default": "json"
        },
        "pagination": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "enum": ["offset", "cursor", "page", "link_header"]
            },
            "page_size": {
              "type": "integer",
              "minimum": 1
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    
    "webhook_config": {
      "type": "object",
      "required": ["path", "method"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "method": {
          "oneOf": [
            {"$ref": "#/definitions/http_method"},
            {
              "type": "array",
              "items": {"$ref": "#/definitions/http_method"}
            }
          ]
        },
        "auth": {
          "$ref": "#/definitions/auth_config"
        },
        "validation": {
          "type": "object",
          "properties": {
            "verify_signature": {
              "type": "boolean",
              "default": false
            },
            "signature_header": {
              "type": "string"
            },
            "allowed_ips": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "ipv4"
              }
            },
            "rate_limit_per_ip": {
              "type": "integer",
              "minimum": 1
            },
            "max_body_size_bytes": {
              "type": "integer",
              "minimum": 1,
              "default": 1048576
            }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "sync": {
              "type": "boolean",
              "default": false,
              "description": "Return response synchronously after processing"
            },
            "status_code": {
              "type": "integer",
              "default": 200
            },
            "body": {
              "type": ["object", "string"]
            }
          }
        }
      }
    },
    
    "kafka_config": {
      "type": "object",
      "required": ["brokers", "topics"],
      "properties": {
        "brokers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "topics": {
          "type": "object",
          "properties": {
            "consume": {
              "type": "array",
              "items": {"type": "string"}
            },
            "produce": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "consumer_group": {
          "type": "string"
        },
        "producer": {
          "type": "object",
          "properties": {
            "acks": {
              "enum": ["0", "1", "all"],
              "default": "all"
            },
            "compression": {
              "enum": ["none", "gzip", "snappy", "lz4", "zstd"],
              "default": "snappy"
            },
            "idempotence": {
              "type": "boolean",
              "default": true
            },
            "max_in_flight": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "linger_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "consumer": {
          "type": "object",
          "properties": {
            "offset_reset": {
              "enum": ["earliest", "latest", "none"],
              "default": "latest"
            },
            "auto_commit": {
              "type": "boolean",
              "default": false
            },
            "max_poll_records": {
              "type": "integer",
              "minimum": 1,
              "default": 500
            },
            "session_timeout_ms": {
              "type": "integer",
              "minimum": 1000,
              "default": 30000
            },
            "heartbeat_interval_ms": {
              "type": "integer",
              "minimum": 1000
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "protocol": {
              "enum": ["PLAINTEXT", "SSL", "SASL_PLAINTEXT", "SASL_SSL"],
              "default": "PLAINTEXT"
            },
            "sasl": {
              "type": "object",
              "properties": {
                "mechanism": {
                  "enum": ["PLAIN", "SCRAM-SHA-256", "SCRAM-SHA-512", "GSSAPI"],
                  "default": "SCRAM-SHA-512"
                },
                "username": {"type": "string"},
                "password_ref": {"type": "string", "pattern": "^secret://"}
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "ca_cert_ref": {"type": "string", "pattern": "^secret://"},
                "client_cert_ref": {"type": "string", "pattern": "^secret://"},
                "client_key_ref": {"type": "string", "pattern": "^secret://"},
                "verify_hostname": {"type": "boolean", "default": true}
              }
            }
          }
        }
      }
    },
    
    "queue_config": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "enum": ["sqs", "azure_queue", "rabbitmq", "redis"],
          "description": "Queue service provider"
        },
        "queue_url": {
          "type": "string",
          "description": "Queue URL (for SQS, Azure)"
        },
        "queue_name": {
          "type": "string",
          "description": "Queue name (for RabbitMQ, Redis)"
        },
        "region": {
          "type": "string",
          "description": "AWS/Azure region"
        },
        "receive": {
          "type": "object",
          "properties": {
            "max_messages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            },
            "wait_time_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 20
            },
            "visibility_timeout_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 43200,
              "default": 300
            }
          }
        },
        "send": {
          "type": "object",
          "properties": {
            "message_group_id": {"type": "string"},
            "deduplication_id_strategy": {
              "enum": ["content_based", "message_id", "custom"],
              "default": "content_based"
            },
            "delay_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 900
            }
          }
        },
        "dlq": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "max_receive_count": {"type": "integer", "minimum": 1, "default": 3},
            "dlq_url": {"type": "string"}
          }
        },
        "auth": {
          "$ref": "#/definitions/auth_config"
        }
      }
    },
    
    "s3_config": {
      "type": "object",
      "required": ["bucket"],
      "properties": {
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "prefix": {
          "type": "string",
          "description": "S3 key prefix/folder"
        },
        "read": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "File pattern to match (glob)"
            },
            "poll_interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 300
            },
            "delete_after_read": {
              "type": "boolean",
              "default": false
            },
            "recursive": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "key_pattern": {
              "type": "string",
              "description": "S3 key pattern with variables like {year}/{month}/{day}/{uuid}"
            },
            "storage_class": {
              "enum": ["STANDARD", "STANDARD_IA", "ONEZONE_IA", "INTELLIGENT_TIERING", "GLACIER", "DEEP_ARCHIVE"],
              "default": "STANDARD"
            },
            "acl": {
              "enum": ["private", "public-read", "public-read-write", "authenticated-read"],
              "default": "private"
            },
            "encryption": {
              "enum": ["none", "AES256", "aws:kms"],
              "default": "AES256"
            },
            "kms_key_id": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          }
        },
        "notifications": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "events": {
              "type": "array",
              "items": {
                "enum": [
                  "s3:ObjectCreated:*",
                  "s3:ObjectCreated:Put",
                  "s3:ObjectCreated:Post",
                  "s3:ObjectRemoved:*",
                  "s3:ObjectRemoved:Delete"
                ]
              }
            },
            "destination": {
              "type": "string",
              "description": "SNS, SQS, or Lambda ARN"
            }
          }
        },
        "auth": {
          "$ref": "#/definitions/auth_config"
        }
      }
    },
    
    "fs_config": {
      "type": "object",
      "required": ["base_path"],
      "properties": {
        "base_path": {
          "type": "string",
          "description": "Base directory path"
        },
        "read": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "File pattern to match (glob)"
            },
            "poll_interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            },
            "delete_after_read": {
              "type": "boolean",
              "default": false
            },
            "recursive": {
              "type": "boolean",
              "default": false
            },
            "follow_symlinks": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "path_pattern": {
              "type": "string",
              "description": "File path pattern with variables"
            },
            "create_dirs": {
              "type": "boolean",
              "default": true
            },
            "permissions": {
              "type": "string",
              "pattern": "^0[0-7]{3}$",
              "default": "0644"
            },
            "rotation": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "strategy": {"enum": ["size", "time", "both"], "default": "size"},
                "max_size_bytes": {"type": "integer", "minimum": 1024},
                "max_age_seconds": {"type": "integer", "minimum": 60},
                "max_files": {"type": "integer", "minimum": 1},
                "compress": {"type": "boolean", "default": false}
              }
            }
          }
        }
      }
    },
    
    "database_config": {
      "type": "object",
      "required": ["driver", "connection"],
      "properties": {
        "driver": {
          "enum": ["postgres", "mysql", "mariadb", "mssql", "oracle", "mongodb", "cassandra", "clickhouse"],
          "description": "Database driver/type"
        },
        "connection": {
          "type": "object",
          "required": ["host", "database"],
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "database": {"type": "string"},
            "username": {"type": "string"},
            "password_ref": {"type": "string", "pattern": "^secret://"},
            "ssl_mode": {
              "enum": ["disable", "require", "verify-ca", "verify-full"],
              "default": "require"
            },
            "pool": {
              "type": "object",
              "properties": {
                "min_size": {"type": "integer", "minimum": 0, "default": 2},
                "max_size": {"type": "integer", "minimum": 1, "default": 10},
                "max_idle_time_seconds": {"type": "integer", "minimum": 0, "default": 300},
                "max_lifetime_seconds": {"type": "integer", "minimum": 0, "default": 3600}
              }
            }
          }
        },
        "read": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "SQL query to fetch records"
            },
            "poll_interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 30
            },
            "mark_processed": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "update_query": {"type": "string"},
                "update_field": {"type": "string"}
              }
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            }
          }
        },
        "write": {
          "type": "object",
          "properties": {
            "table": {"type": "string"},
            "mode": {
              "enum": ["insert", "upsert", "update", "replace"],
              "default": "insert"
            },
            "conflict_columns": {
              "type": "array",
              "items": {"type": "string"}
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "batch_timeout_ms": {
              "type": "integer",
              "minimum": 10,
              "default": 1000
            }
          }
        }
      }
    },
    
    "grpc_config": {
      "type": "object",
      "required": ["endpoint", "service"],
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "gRPC server endpoint (host:port)"
        },
        "service": {
          "type": "string",
          "description": "Fully qualified service name"
        },
        "methods": {
          "type": "object",
          "properties": {
            "read": {"type": "string", "description": "Method for reading/streaming"},
            "write": {"type": "string", "description": "Method for writing"}
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "insecure_skip_verify": {"type": "boolean", "default": false},
            "ca_cert_ref": {"type": "string", "pattern": "^secret://"},
            "client_cert_ref": {"type": "string", "pattern": "^secret://"},
            "client_key_ref": {"type": "string", "pattern": "^secret://"},
            "server_name_override": {"type": "string"}
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "gRPC metadata headers"
        },
        "keepalive": {
          "type": "object",
          "properties": {
            "time_seconds": {"type": "integer", "minimum": 1, "default": 30},
            "timeout_seconds": {"type": "integer", "minimum": 1, "default": 10},
            "permit_without_stream": {"type": "boolean", "default": true}
          }
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "default": 30},
        "max_receive_message_size_mb": {"type": "integer", "minimum": 1, "default": 4},
        "max_send_message_size_mb": {"type": "integer", "minimum": 1, "default": 4}
      }
    },
    
    "pubsub_config": {
      "type": "object",
      "required": ["provider", "project_id"],
      "properties": {
        "provider": {
          "enum": ["gcp", "azure", "aws_sns"],
          "description": "Pub/Sub provider"
        },
        "project_id": {
          "type": "string",
          "description": "GCP project ID or equivalent"
        },
        "subscription": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "topic": {"type": "string"},
            "ack_deadline_seconds": {"type": "integer", "minimum": 10, "maximum": 600, "default": 60},
            "max_outstanding_messages": {"type": "integer", "minimum": 1, "default": 1000},
            "max_outstanding_bytes": {"type": "integer", "minimum": 1024, "default": 104857600}
          }
        },
        "publisher": {
          "type": "object",
          "properties": {
            "topic": {"type": "string"},
            "batch": {
              "type": "object",
              "properties": {
                "max_messages": {"type": "integer", "minimum": 1, "default": 100},
                "max_bytes": {"type": "integer", "minimum": 1024, "default": 1048576},
                "delay_threshold_ms": {"type": "integer", "minimum": 1, "default": 100}
              }
            },
            "ordering_key": {"type": "string"},
            "enable_message_ordering": {"type": "boolean", "default": false}
          }
        },
        "auth": {
          "$ref": "#/definitions/auth_config"
        }
      }
    }
  },
  "type": "object",
  "required": ["id", "name", "type", "direction", "enabled", "config"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier for the connector"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name"
    },
    "type": {
      "$ref": "#/definitions/connector_types"
    },
    "direction": {
      "$ref": "#/definitions/direction"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "config": {
      "oneOf": [
        {"$ref": "#/definitions/http_poll_config"},
        {"$ref": "#/definitions/webhook_config"},
        {"$ref": "#/definitions/kafka_config"},
        {"$ref": "#/definitions/queue_config"},
        {"$ref": "#/definitions/s3_config"},
        {"$ref": "#/definitions/fs_config"},
        {"$ref": "#/definitions/database_config"},
        {"$ref": "#/definitions/grpc_config"},
        {"$ref": "#/definitions/pubsub_config"}
      ]
    },
    "state_management": {
      "$ref": "#/definitions/state_management"
    },
    "metadata": {
      "$ref": "#/definitions/metadata"
    }
  },
  "examples": [
    {
      "id": "http_orders_poll",
      "name": "Orders API Polling",
      "type": "http_poll",
      "direction": "source",
      "enabled": true,
      "config": {
        "url": "https://api.example.com/orders",
        "method": "GET",
        "interval_seconds": 60,
        "timeout_seconds": 30,
        "auth": {
          "type": "bearer",
          "bearer_token": "secret://api-token"
        }
      },
      "state_management": {
        "enabled": true,
        "type": "cursor",
        "storage": {
          "backend": "postgres",
          "location": "connector_state",
          "encryption": true
        },
        "checkpoint": {
          "interval_seconds": 30,
          "on_batch_complete": true,
          "strategy": "incremental"
        },
        "cursor": {
          "field": "last_modified",
          "initial_value": "2024-01-01T00:00:00Z",
          "format": "iso8601"
        }
      },
      "metadata": {
        "description": "Polls orders API every minute",
        "tags": ["production", "orders"],
        "owner": "data-team"
      }
    }
  ]
}

