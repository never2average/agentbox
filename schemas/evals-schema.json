{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Evals Schema",
  "description": "Validation schema for evaluation suites and cases used to assess agents, tools, models, or recipes",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "target_type": {
      "enum": ["agent", "tool", "model", "recipe"]
    },
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "$ref": "#/definitions/target_type" },
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "id": { "type": "string" },
        "input": { "type": "object" },
        "expected": {},
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "dataset_inline": {
      "type": "object",
      "required": ["type", "cases"],
      "properties": {
        "type": { "const": "inline" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/case" }
        }
      },
      "additionalProperties": false
    },
    "dataset_file": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "file" },
        "path": { "type": "string" },
        "format": { "enum": ["jsonl", "json", "csv"], "default": "jsonl" },
        "field_mapping": {
          "type": "object",
          "properties": {
            "input": { "type": "string" },
            "expected": { "type": "string" },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "encoding": { "type": "string", "default": "utf-8" }
      },
      "additionalProperties": false
    },
    "dataset_io_connector": {
      "type": "object",
      "required": ["type", "connector_id"],
      "properties": {
        "type": { "const": "io_connector" },
        "connector_id": { "type": "string" },
        "filters": { "type": "object" },
        "batch_size": { "type": "integer", "minimum": 1, "default": 100 }
      },
      "additionalProperties": false
    },
    "dataset": {
      "oneOf": [
        { "$ref": "#/definitions/dataset_inline" },
        { "$ref": "#/definitions/dataset_file" },
        { "$ref": "#/definitions/dataset_io_connector" }
      ]
    },
    "metric_exact_match": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "exact_match" },
        "case_sensitive": { "type": "boolean", "default": false },
        "normalize_whitespace": { "type": "boolean", "default": true },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metric_contains": {
      "type": "object",
      "required": ["type", "needle"],
      "properties": {
        "type": { "const": "contains" },
        "needle": { "type": "string" },
        "case_sensitive": { "type": "boolean", "default": false },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metric_regex": {
      "type": "object",
      "required": ["type", "pattern"],
      "properties": {
        "type": { "const": "regex" },
        "pattern": { "type": "string" },
        "flags": { "type": "string", "default": "" },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metric_numeric": {
      "type": "object",
      "required": ["type", "op", "value"],
      "properties": {
        "type": { "const": "numeric" },
        "path": { "type": "string" },
        "op": { "$ref": "./common-schema.json#/definitions/comparison_operator" },
        "value": { "type": ["number", "string"] }
      },
      "additionalProperties": false
    },
    "metric_semantic_similarity": {
      "type": "object",
      "required": ["type", "model_id", "gateway_id", "threshold"],
      "properties": {
        "type": { "const": "semantic_similarity" },
        "model_id": { "type": "string" },
        "gateway_id": { "type": "string" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metric_llm_judge": {
      "type": "object",
      "required": ["type", "model_id", "gateway_id", "prompt_template"],
      "properties": {
        "type": { "const": "llm_judge" },
        "model_id": { "type": "string" },
        "gateway_id": { "type": "string" },
        "execution_mode": { "enum": ["inline", "background"], "default": "inline" },
        "prompt_template": { "type": "string" },
        "input_binding": {
          "type": "object",
          "properties": {
            "expected": { "type": "string" },
            "actual": { "type": "string" }
          },
          "additionalProperties": false
        },
        "output_parser": {
          "type": "object",
          "properties": {
            "regex": { "type": "string" },
            "cast": { "enum": ["float", "int", "string"] },
            "label_map": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "score_range": {
          "type": "object",
          "properties": {
            "min": { "type": "number", "default": 0 },
            "max": { "type": "number", "default": 1 }
          },
          "additionalProperties": false
        },
        "threshold": { "type": "number" },
        "cache_ttl_seconds": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "scoring_metric": {
      "oneOf": [
        { "$ref": "#/definitions/metric_exact_match" },
        { "$ref": "#/definitions/metric_contains" },
        { "$ref": "#/definitions/metric_regex" },
        { "$ref": "#/definitions/metric_numeric" },
        { "$ref": "#/definitions/metric_semantic_similarity" },
        { "$ref": "#/definitions/metric_llm_judge" }
      ]
    },
    "scoring": {
      "type": "object",
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric"],
            "properties": {
              "metric": { "$ref": "#/definitions/scoring_metric" },
              "weight": { "type": "number", "minimum": 0, "default": 1 }
            },
            "additionalProperties": false
          }
        },
        "aggregation": { "enum": ["weighted_average", "min", "max", "all_pass"], "default": "weighted_average" },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
      },
      "additionalProperties": false
    },
    "run_config": {
      "type": "object",
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "default": 42 },
        "max_concurrency": { "type": "integer", "minimum": 1, "default": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "default": 60 },
        "stop_on_fail": { "type": "boolean", "default": false },
        "randomize_order": { "type": "boolean", "default": false },
        "retries_on_error": { "type": "integer", "minimum": 0, "default": 0 },
        "store_outputs": { "type": "boolean", "default": true },
        "log_level": { "enum": ["debug", "info", "warning", "error"], "default": "info" }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "target", "dataset", "scoring"],
  "properties": {
    "id": { "$ref": "./common-schema.json#/definitions/id" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "target": { "$ref": "#/definitions/target" },
    "dataset": { "$ref": "#/definitions/dataset" },
    "scoring": { "$ref": "#/definitions/scoring" },
    "run_config": { "$ref": "#/definitions/run_config" },
    "tags": { "$ref": "./common-schema.json#/definitions/tags" },
    "metadata": { "$ref": "./common-schema.json#/definitions/metadata" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "eval_summarization_basic",
      "name": "Summarization Accuracy",
      "description": "Check if agent output contains key phrase and passes regex",
      "target": { "type": "agent", "id": "agent_summarizer", "version": ">=1.0.0" },
      "dataset": {
        "type": "inline",
        "cases": [
          {
            "id": "case_1",
            "input": { "text": "The quick brown fox jumps over the lazy dog." },
            "expected": "quick brown fox"
          }
        ]
      },
      "scoring": {
        "metrics": [
          { "metric": { "type": "contains", "needle": "quick brown fox", "case_sensitive": false }, "weight": 0.5 },
          { "metric": { "type": "regex", "pattern": "fox", "flags": "i" }, "weight": 0.5 }
        ],
        "aggregation": "weighted_average",
        "pass_threshold": 0.9
      },
      "run_config": {
        "max_concurrency": 2,
        "timeout_seconds": 45,
        "stop_on_fail": false
      },
      "tags": ["eval", "summarization"]
    }
  ]
}


