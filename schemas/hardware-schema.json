{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Hardware Schema",
  "description": "Validation schema for hardware nodepools, specs, autoscaling, constraints, and health checks",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "status": {
      "enum": ["active", "inactive", "maintenance", "degraded"]
    },
    "cpu": {
      "type": "object",
      "required": ["cores", "architecture"],
      "properties": {
        "cores": { "type": "integer", "minimum": 0 },
        "architecture": { "enum": ["x86_64", "arm64"] }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["total_gb", "available_gb"],
      "properties": {
        "total_gb": { "type": "number", "minimum": 0 },
        "available_gb": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "gpu": {
      "type": "object",
      "required": ["enabled", "type", "count", "memory_gb"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "memory_gb": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["type", "size_gb", "iops"],
      "properties": {
        "type": { "enum": ["ssd", "nvme", "hdd"] },
        "size_gb": { "type": "number", "minimum": 0 },
        "iops": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": ["bandwidth_gbps", "public_ip"],
      "properties": {
        "bandwidth_gbps": { "type": "number", "minimum": 0 },
        "public_ip": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "node_spec": {
      "type": "object",
      "required": ["cpu", "memory", "gpu", "storage", "network"],
      "properties": {
        "cpu": { "$ref": "#/definitions/cpu" },
        "memory": { "$ref": "#/definitions/memory" },
        "gpu": { "$ref": "#/definitions/gpu" },
        "storage": { "$ref": "#/definitions/storage" },
        "network": { "$ref": "#/definitions/network" }
      },
      "additionalProperties": false
    },
    "node_count": {
      "type": "object",
      "required": ["min", "max", "current"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "current": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "$gt": { "type": "number" },
        "$lt": { "type": "number" },
        "$gte": { "type": "number" },
        "$lte": { "type": "number" },
        "$eq": { "type": ["number", "string", "boolean"] }
      },
      "additionalProperties": false
    },
    "inc_dec": {
      "type": "object",
      "properties": {
        "$inc": { "type": "number" },
        "$dec": { "type": "number" }
      },
      "additionalProperties": false
    },
    "node_spec_change": {
      "type": "object",
      "properties": {
        "cpu": { "$ref": "#/definitions/inc_dec" },
        "memory": { "$ref": "#/definitions/inc_dec" },
        "gpu": { "$ref": "#/definitions/inc_dec" },
        "storage": { "$ref": "#/definitions/inc_dec" },
        "network": { "$ref": "#/definitions/inc_dec" }
      },
      "additionalProperties": false
    },
    "autoscale_rule": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "$gt": { "type": "number" },
        "$lt": { "type": "number" },
        "node_count": { "$ref": "#/definitions/inc_dec" },
        "node_spec_change": { "$ref": "#/definitions/node_spec_change" }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "$max": { "type": "number" },
        "$min": { "type": "number" }
      },
      "additionalProperties": false
    },
    "health_rule": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "$max": { "type": "number" },
        "$min": { "type": "number" },
        "notification_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["nodepool_id", "nodepool_name", "region", "zone", "node_count", "node_spec", "status"],
  "properties": {
    "nodepool_id": { "type": "string" },
    "nodepool_name": { "type": "string" },
    "region": { "type": "string" },
    "zone": { "type": "string" },
    "node_count": { "$ref": "#/definitions/node_count" },
    "node_spec": { "$ref": "#/definitions/node_spec" },
    "autoscale": {
      "type": "array",
      "items": { "$ref": "#/definitions/autoscale_rule" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/definitions/constraint" }
    },
    "health": {
      "type": "array",
      "items": { "$ref": "#/definitions/health_rule" }
    },
    "status": { "$ref": "#/definitions/status" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "nodepool_id": "np_gpu_east1",
      "nodepool_name": "gpu-east-1",
      "region": "us-east-1",
      "zone": "us-east-1a",
      "node_count": { "min": 0, "max": 20, "current": 4 },
      "node_spec": {
        "cpu": { "cores": 32, "architecture": "x86_64" },
        "memory": { "total_gb": 256, "available_gb": 128 },
        "gpu": { "enabled": true, "type": "A100", "count": 4, "memory_gb": 80 },
        "storage": { "type": "nvme", "size_gb": 2000, "iops": 100000 },
        "network": { "bandwidth_gbps": 25, "public_ip": false }
      },
      "autoscale": [
        { "id": "metric_gpu_util", "$gt": 1000, "node_count": { "$inc": 2 }, "node_spec_change": { "gpu": { "$inc": 1 } } },
        { "id": "metric_gpu_util", "$lt": 200, "node_count": { "$dec": 1 }, "node_spec_change": { "gpu": { "$dec": 1 } } }
      ],
      "constraints": [
        { "id": "metric_power_budget", "$max": 5000, "$min": 1000 }
      ],
      "health": [
        { "id": "metric_temp", "$max": 85, "$min": 5, "notification_ids": ["notification_1"] }
      ],
      "status": "active"
    }
  ]
}

