{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentBox Policies Schema",
  "description": "Validation schema for governance policies with metric conditions and effects",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "policy_status": { "enum": ["enforce", "monitor", "disabled"] },
    "target_type": { "enum": ["agent", "tool", "gateway", "channel", "hardware", "runtime", "model"] },
    "attribute_match": {
      "type": "object",
      "required": ["key", "op"],
      "properties": {
        "key": { "type": "string" },
        "op": { "$ref": "./common-schema.json#/definitions/comparison_operator" },
        "value": {}
      },
      "additionalProperties": false
    },
    "dimension_filter": {
      "type": "object",
      "required": ["name", "op"],
      "properties": {
        "name": { "type": "string" },
        "op": { "enum": ["eq", "in", "matches"] },
        "value": {}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["metric_id", "operator", "threshold", "statistic", "period_seconds"],
      "properties": {
        "metric_id": { "type": "string" },
        "operator": { "enum": ["gt", "gte", "lt", "lte", "eq", "neq"] },
        "threshold": { "type": "number" },
        "statistic": { "enum": ["Average", "Sum", "Minimum", "Maximum", "p50", "p90", "p95", "p99"] },
        "period_seconds": { "type": "integer", "minimum": 1, "default": 60 },
        "evaluation_periods": { "type": "integer", "minimum": 1, "default": 1 },
        "datapoints_to_trigger": { "type": "integer", "minimum": 1, "default": 1 },
        "dimension_filters": {
          "type": "array",
          "items": { "$ref": "#/definitions/dimension_filter" }
        }
      },
      "additionalProperties": false
    },
    "conditions_block": {
      "type": "object",
      "properties": {
        "$and": {
          "type": "array",
          "items": { "$ref": "#/definitions/condition" }
        },
        "$or": {
          "type": "array",
          "items": { "$ref": "#/definitions/condition" }
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "target_type": { "$ref": "#/definitions/target_type" },
        "target_ids": { "type": "array", "items": { "type": "string" } },
        "selector": {
          "type": "object",
          "properties": {
            "tags": { "$ref": "./common-schema.json#/definitions/tags" },
            "attributes_match": {
              "type": "array",
              "items": { "$ref": "#/definitions/attribute_match" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metric_math": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "expression": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "nan_handling": { "enum": ["treat_as_zero", "propagate", "skip"] }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["allow", "deny", "limit", "throttle", "scale", "route", "pause", "resume", "notify"] },
        "parameters": {
          "type": "object",
          "properties": {
            "limit_per_minute": { "type": "integer", "minimum": 0 },
            "throttle_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "route_to_gateway_id": { "type": "string" },
            "scale": {
              "type": "object",
              "properties": {
                "nodepool_id": { "type": "string" },
                "node_count": {
                  "type": "object",
                  "properties": {
                    "$inc": { "type": "integer" },
                    "$dec": { "type": "integer" }
                  },
                  "additionalProperties": false
                },
                "node_spec_change": { "type": "object" }
              },
              "additionalProperties": false
            },
            "notify": {
              "type": "object",
              "properties": {
                "notification_ids": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "status", "priority", "conditions", "effect"],
  "properties": {
    "id": { "$ref": "./common-schema.json#/definitions/id" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "status": { "$ref": "#/definitions/policy_status" },
    "priority": { "type": "integer", "minimum": 0, "default": 100 },
    "metrics_source": { "enum": ["logs_only"] },
    "require_valid_logs": { "type": "boolean", "default": true },
    "scope": { "$ref": "#/definitions/scope" },
    "conditions": { "$ref": "#/definitions/conditions_block" },
    "metric_math": { "$ref": "#/definitions/metric_math" },
    "effect": { "$ref": "#/definitions/effect" },
    "cooldown_seconds": { "type": "integer", "minimum": 0, "default": 60 },
    "suppress_for_seconds": { "type": "integer", "minimum": 0, "default": 0 },
    "tags": { "$ref": "./common-schema.json#/definitions/tags" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "policy_throttle_high_rps",
      "name": "Throttle on high request rate",
      "status": "enforce",
      "priority": 10,
      "conditions": {
        "$and": [
          { "metric_id": "metric_rps", "operator": "gt", "threshold": 1000, "statistic": "Average", "period_seconds": 60 }
        ]
      },
      "effect": {
        "type": "throttle",
        "parameters": { "throttle_percent": 20 }
      },
      "cooldown_seconds": 120
    }
  ]
}

